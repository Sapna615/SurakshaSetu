@page
@model SurakshaSetu.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Enter your email and we'll generate a reset link for you.</p>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>

    <div class="mb-4 text-start">
        <label asp-for="Input.Email" class="form-label">Email Address</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="you@example.com" />
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <button type="submit" class="w-100 btn btn-primary mb-3">Generate Reset Link</button>

    <div class="auth-links">
        <a asp-page="./Login">← Back to Sign In</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
