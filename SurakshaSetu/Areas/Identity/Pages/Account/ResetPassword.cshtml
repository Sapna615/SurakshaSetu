@page
@model SurakshaSetu.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Enter your new password below.</p>

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info py-2 mb-3" style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3); color: #38bdf8; font-size: 0.9rem; border-radius: 12px;">@TempData["InfoMessage"]</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>
    <input asp-for="Input.Code" type="hidden" />
    <input asp-for="Input.Email" type="hidden" />

    <div class="mb-3 text-start">
        <label asp-for="Input.Email" class="form-label">Email Address</label>
        <input asp-for="Input.Email" class="form-control" readonly disabled style="opacity: 0.8; cursor: not-allowed;" />
    </div>

    <div class="mb-3 text-start">
        <label asp-for="Input.Password" class="form-label">New Password</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Enter new password" />
        <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <div class="mb-4 text-start">
        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm new password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <button type="submit" class="w-100 btn btn-primary mb-3" style="background: #10b981; border: none; box-shadow: 0 10px 15px -3px rgba(16, 185, 129, 0.3);">Reset Password</button>

    <div class="auth-links">
        <a asp-page="./Login">← Back to Sign In</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
