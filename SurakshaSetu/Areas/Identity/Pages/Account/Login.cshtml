@page
@model SurakshaSetu.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Secure access for campus safety</p>

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>
    
    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">Email Address</label>
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>
    
    <div class="form-floating mb-4">
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
        <label asp-for="Input.Password">Password</label>
        <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>
    
    <div class="checkbox mb-4 d-flex justify-content-between align-items-center">
        <label asp-for="Input.RememberMe" class="form-label text-muted fw-medium m-0" style="font-size: 0.95rem;">
            <input class="form-check-input me-2" asp-for="Input.RememberMe" style="cursor: pointer;" />
            @Html.DisplayNameFor(m => m.Input.RememberMe)
        </label>
        <a id="forgot-password" asp-page="./ForgotPassword" style="font-size: 0.9rem; color: var(--primary); text-decoration: none; font-weight: 600;">Forgot password?</a>
    </div>
    
    <button id="login-submit" type="submit" class="w-100 btn btn-primary">Sign In Securely</button>
    
    <div class="auth-links mt-4">
        <span style="color: #64748b; font-size: 0.9rem;">Don't have an account?</span> 
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="display: inline; margin-left: 5px;">Register here</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
