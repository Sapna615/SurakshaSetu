@page
@model SurakshaSetu.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Secure access for campus safety</p>

<form id="account" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>
    
    <div class="mb-3 text-start">
        <label asp-for="Input.Email" class="form-label">Email Address</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>
    
    <div class="mb-3 text-start">
        <label asp-for="Input.Password" class="form-label">Password</label>
        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Enter your password" />
        <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>
    
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div class="form-check m-0">
            <input class="form-check-input" asp-for="Input.RememberMe" id="rememberMeCheck" style="cursor: pointer; background-color: #09101a; border-color: #1e2d42;" />
            <label class="form-check-label text-muted" for="rememberMeCheck" style="font-size: 0.9rem; cursor: pointer; color: #94a3b8 !important;">
                @Html.DisplayNameFor(m => m.Input.RememberMe)
            </label>
        </div>
        <a id="forgot-password" asp-page="./ForgotPassword" style="font-size: 0.9rem; color: #38bdf8; text-decoration: none; font-weight: 500;">Forgot password?</a>
    </div>
    
    <button id="login-submit" type="submit" class="w-100 btn btn-primary">Sign In Securely</button>
    
    <div class="auth-links mt-4">
        <span style="color: #64748b; font-size: 0.9rem;">Don't have an account?</span> 
        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" style="display: inline; margin-left: 5px;">Register here</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
