@page
@model SurakshaSetu.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Create a student account to report incidents and receive safety alerts.</p>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>
    
    <div class="mb-3 text-start">
        <label asp-for="Input.FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
        <input asp-for="Input.FullName" class="form-control" aria-required="true" placeholder="John Doe" />
        <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <div class="mb-3 text-start">
        <label asp-for="Input.Email" class="form-label">University Email <span class="text-danger">*</span></label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="student@university.edu" />
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <div class="row g-2 mb-3 text-start">
        <div class="col-6">
            <label asp-for="Input.Password" class="form-label">Password <span class="text-danger">*</span></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
            <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-6">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm <span class="text-danger">*</span></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="••••••••" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
    </div>

    <div class="d-flex align-items-center my-3">
        <div class="flex-grow-1" style="height: 1px; background: #1e2d42;"></div>
        <span style="font-size: 0.75rem; color: #64748b; font-weight: 600; text-transform: uppercase; padding: 0 10px; letter-spacing: 0.5px;">Optional Details</span>
        <div class="flex-grow-1" style="height: 1px; background: #1e2d42;"></div>
    </div>

    <div class="row g-2 mb-3 text-start">
        <div class="col-4">
            <label asp-for="Input.StudentId" class="form-label" style="font-size: 0.8rem;">Student ID</label>
            <input asp-for="Input.StudentId" class="form-control" placeholder="e.g. 210101" />
            <span asp-validation-for="Input.StudentId" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-4">
            <label asp-for="Input.Department" class="form-label" style="font-size: 0.8rem;">Dept</label>
            <input asp-for="Input.Department" class="form-control" placeholder="e.g. CSE" />
            <span asp-validation-for="Input.Department" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-4">
            <label asp-for="Input.Year" class="form-label" style="font-size: 0.8rem;">Year</label>
            <input asp-for="Input.Year" class="form-control" placeholder="e.g. 3rd" />
            <span asp-validation-for="Input.Year" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
    </div>

    <div class="mb-4 text-start">
        <label asp-for="Input.Role" class="form-label">Account Role <span class="text-danger">*</span></label>
        <select asp-for="Input.Role" class="form-select" style="cursor: pointer;">
            <option value="Student">Student (Default)</option>
            <option value="SecurityOfficer">Security Officer</option>
            <option value="Admin">Admin</option>
            <option value="SuperAdmin">Super Admin</option>
        </select>
        <span asp-validation-for="Input.Role" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Create Account</button>
    
    <div class="auth-links mt-4">
        <span style="color: #64748b; font-size: 0.9rem;">Already have an account?</span> 
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="display: inline; margin-left: 5px;">Log in instead</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
