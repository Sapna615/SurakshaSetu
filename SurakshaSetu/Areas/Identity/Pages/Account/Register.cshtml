@page
@model SurakshaSetu.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create Account";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<p class="auth-subtitle">Create a student account to report incidents and receive safety alerts.</p>

<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="font-size: 0.9rem;"></div>
    
    <div class="form-floating mb-3">
        <input asp-for="Input.FullName" class="form-control" aria-required="true" placeholder="John Doe" />
        <label asp-for="Input.FullName">Full Name <span class="text-danger">*</span></label>
        <span asp-validation-for="Input.FullName" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Input.Email">University Email <span class="text-danger">*</span></label>
        <span asp-validation-for="Input.Email" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 form-floating">
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
            <label asp-for="Input.Password" class="ms-1">Password <span class="text-danger">*</span></label>
            <span asp-validation-for="Input.Password" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-6 form-floating">
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
            <label asp-for="Input.ConfirmPassword" class="ms-1">Confirm <span class="text-danger">*</span></label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
    </div>

    <div class="d-flex align-items-center mb-3">
        <div class="flex-grow-1" style="height: 1px; background: #e2e8f0;"></div>
        <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; padding: 0 10px;">Optional Details</span>
        <div class="flex-grow-1" style="height: 1px; background: #e2e8f0;"></div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-4 form-floating">
            <input asp-for="Input.StudentId" class="form-control" placeholder="ID" />
            <label asp-for="Input.StudentId" class="ms-1">Student ID</label>
            <span asp-validation-for="Input.StudentId" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-4 form-floating">
            <input asp-for="Input.Department" class="form-control" placeholder="Dept" />
            <label asp-for="Input.Department" class="ms-1">Dept</label>
            <span asp-validation-for="Input.Department" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
        <div class="col-4 form-floating">
            <input asp-for="Input.Year" class="form-control" placeholder="Year" />
            <label asp-for="Input.Year" class="ms-1">Year</label>
            <span asp-validation-for="Input.Year" class="text-danger" style="font-size: 0.85rem;"></span>
        </div>
    </div>

    <div class="form-floating mb-4">
        <select asp-for="Input.Role" class="form-control" style="cursor: pointer; appearance: auto;">
            <option value="Student">Student (Default)</option>
            <option value="SecurityOfficer">Security Officer</option>
            <option value="Admin">Admin</option>
            <option value="SuperAdmin">Super Admin</option>
        </select>
        <label asp-for="Input.Role">Account Role <span class="text-danger">*</span></label>
        <span asp-validation-for="Input.Role" class="text-danger" style="font-size: 0.85rem;"></span>
    </div>

    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Create Account</button>
    
    <div class="auth-links mt-4">
        <span style="color: #64748b; font-size: 0.9rem;">Already have an account?</span> 
        <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" style="display: inline; margin-left: 5px;">Log in instead</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
