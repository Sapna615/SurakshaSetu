@page
@model SurakshaSetu.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="text-center py-2">
    <div class="mb-3" style="font-size: 3rem;">✅</div>
    <h3 style="color: #ffffff; font-weight: 700; margin-bottom: 0.75rem;">Password Reset!</h3>
    <p style="color: #94a3b8; font-size: 0.95rem; margin-bottom: 2rem; line-height: 1.6;">Your password has been successfully reset. You can now securely sign in to your account with your new credentials.</p>
    <a asp-page="./Login" class="btn btn-primary w-100">Sign In Now</a>
</div>
