@model SurakshaSetu.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Summary";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">Executive Analytics</h2>
        <p class="text-muted">High-level overview of campus safety performance.</p>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-left: 4px solid #3b82f6 !important;">
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-bold mb-2">Total Reports (YTD)</h6>
                <h2 class="fw-bold mb-0">@Model.TotalReports</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-left: 4px solid #ef4444 !important;">
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-bold mb-2">Active SOS</h6>
                <h2 class="fw-bold mb-0">@Model.ActiveSOS</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-left: 4px solid #f59e0b !important;">
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-bold mb-2">Open Incidents</h6>
                <h2 class="fw-bold mb-0">@Model.OpenCases</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm border-0" style="border-left: 4px solid #10b981 !important;">
            <div class="card-body">
                <h6 class="text-muted text-uppercase fw-bold mb-2">Resolved Cases</h6>
                <h2 class="fw-bold mb-0">@Model.ResolvedCases</h2>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">Recent System Activity</h5>
        <a href="/Management/Reports" class="btn btn-sm btn-outline-primary">View Full Analytics</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">Report ID</th>
                        <th class="border-0">Category</th>
                        <th class="border-0">Location</th>
                        <th class="border-0">Created At</th>
                        <th class="border-0">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentReports != null && Model.RecentReports.Any())
                    {
                        foreach (var incident in Model.RecentReports)
                        {
                            <tr>
                                <td class="fw-bold">@incident.ReportId</td>
                                <td><span class="badge bg-secondary">@incident.IncidentCategory</span></td>
                                <td>@incident.IncidentLocation</td>
                                <td>@incident.CreatedAt.ToString("HH:mm:ss") <small class="text-muted">(@incident.CreatedAt.ToString("dd MMM"))</small></td>
                                <td>
                                    @if(incident.Status == "Pending" || incident.Status == "Submitted") { <span class="badge bg-danger">@incident.Status</span> }
                                    else if(incident.Status == "In Progress") { <span class="badge bg-warning text-dark">@incident.Status</span> }
                                    else if(incident.Status == "Resolved") { <span class="badge bg-success">@incident.Status</span> }
                                    else { <span class="badge bg-info">@incident.Status</span> }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <div><span style="font-size: 2rem;">📋</span></div>
                                <div>No activity found.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
