@{
    Layout = null;
    ViewData["Title"] = "SurakshaSetu | Campus Safety Platform";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root {
            --primary: #2563eb;
            --primary-dark: #1d4ed8;
            --secondary: #0f172a;
            --accent: #f59e0b;
            --danger: #ef4444;
            --light: #f8fafc;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            padding: 0;
            background-color: #0b1120;
            color: #f8fafc;
            overflow-x: hidden;
        }

        /* Ambient Glow & Mesh Background */
        .ambient-glow {
            position: absolute;
            width: 700px;
            height: 700px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,0.2) 0%, rgba(37,99,235,0) 70%);
            top: -200px;
            right: -100px;
            pointer-events: none;
            z-index: 0;
        }
        .ambient-glow-2 {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(225,29,72,0.15) 0%, rgba(225,29,72,0) 70%);
            bottom: 5%;
            left: -150px;
            pointer-events: none;
            z-index: 0;
        }

        /* Glass Navbar */
        .navbar-custom {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.25rem 3.5rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 100;
            background: rgba(11, 17, 32, 0.75);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.3s ease;
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 1.35rem;
            font-weight: 800;
            color: white;
            text-decoration: none;
            letter-spacing: -0.5px;
        }
        .brand-shield {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
        }

        /* Hero Section */
        .hero {
            min-height: 100vh;
            display: flex;
            align-items: center;
            position: relative;
            padding-top: 130px;
            padding-bottom: 80px;
            background: radial-gradient(circle at top left, #1e293b 0%, #0b1120 60%);
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 18px;
            background: rgba(37, 99, 235, 0.15);
            color: #60a5fa;
            border: 1px solid rgba(96, 165, 250, 0.25);
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.85rem;
            margin-bottom: 24px;
            backdrop-filter: blur(10px);
        }

        .hero-title {
            font-size: 4.2rem;
            font-weight: 900;
            line-height: 1.1;
            margin-bottom: 24px;
            letter-spacing: -1.5px;
            color: white;
        }

        .hero-title .text-gradient {
            background: linear-gradient(135deg, #60a5fa 0%, #a855f7 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-subtitle {
            font-size: 1.2rem;
            color: #94a3b8;
            margin-bottom: 40px;
            max-width: 580px;
            line-height: 1.6;
        }

        .btn-custom {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 28px;
            font-size: 1.05rem;
            font-weight: 700;
            border-radius: 12px;
            text-decoration: none;
            transition: all 0.25s ease;
            cursor: pointer;
        }

        .btn-primary-glow {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            border: 1px solid rgba(255,255,255,0.15);
            box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.5);
        }
        .btn-primary-glow:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            transform: translateY(-2px);
            box-shadow: 0 15px 35px -5px rgba(37, 99, 235, 0.7);
            color: white;
        }

        .btn-glass {
            background: rgba(255, 255, 255, 0.05);
            color: #e2e8f0;
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(10px);
        }
        .btn-glass:hover {
            background: rgba(255, 255, 255, 0.1);
            color: white;
            border-color: rgba(255, 255, 255, 0.25);
            transform: translateY(-2px);
        }

        /* Glass Feature Cards */
        .feature-card {
            background: rgba(30, 41, 59, 0.6);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 32px;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);
            height: 100%;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }
        .feature-card:hover {
            transform: translateY(-8px);
            border-color: rgba(96, 165, 250, 0.3);
            box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.25);
        }

        .feature-icon {
            width: 54px;
            height: 54px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            margin-bottom: 20px;
        }
        .icon-red { background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25); }
        .icon-purple { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.25); }
        .icon-blue { background: rgba(37, 99, 235, 0.15); color: #60a5fa; border: 1px solid rgba(37, 99, 235, 0.25); }
        .icon-amber { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.25); }

        .feature-title {
            font-size: 1.25rem;
            font-weight: 800;
            color: white;
            margin-bottom: 10px;
        }
        .feature-desc {
            color: #94a3b8;
            font-size: 0.95rem;
            line-height: 1.6;
            margin: 0;
        }

        /* Floating Trust Stats */
        .trust-stat-box {
            background: rgba(15, 23, 42, 0.7);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            padding: 20px 24px;
            backdrop-filter: blur(12px);
            display: flex;
            align-items: center;
            gap: 16px;
        }
        .trust-stat-num {
            font-size: 1.8rem;
            font-weight: 900;
            color: white;
            line-height: 1;
        }
        .trust-stat-lbl {
            font-size: 0.8rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-weight: 700;
        }

        @@media (max-width: 991px) {
            .hero-title { font-size: 2.8rem; }
            .navbar-custom { padding: 1rem 1.5rem; }
            .hero { padding-top: 100px; }
        }
    </style>
</head>
<body>

    <div class="ambient-glow"></div>
    <div class="ambient-glow-2"></div>

    <!-- NAVBAR -->
    <nav class="navbar-custom">
        <a href="/" class="brand-logo">
            <div class="brand-shield">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <span>SurakshaSetu</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <a href="#emergency-connect" class="btn-custom btn-glass py-2 px-3 d-none d-md-inline-flex" style="font-size: 0.88rem;">
                <i class="bi bi-telephone-inbound-fill text-danger me-1"></i> Emergency Lines
            </a>
            <a href="/Identity/Account/Login" class="btn-custom btn-primary-glow py-2 px-4" style="font-size: 0.9rem;">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In / Portal
            </a>
        </div>
    </nav>

    <!-- HERO SECTION -->
    <section class="hero">
        <div class="container-fluid px-lg-5">
            <div class="row align-items-center g-5">
                <div class="col-lg-6">
                    <div class="hero-badge">
                        <i class="bi bi-patch-check-fill text-primary"></i> Enterprise University Safety Platform
                    </div>
                    <h1 class="hero-title">
                        Empowering a <span class="text-gradient">Safer Campus</span> Community.
                    </h1>
                    <p class="hero-subtitle">
                        An integrated, confidential safety ecosystem connecting students, campus security, counseling centers, and hostel wardens with 24/7 emergency dispatch.
                    </p>
                    
                    <div class="d-flex flex-wrap gap-3 mb-5">
                        <div class="btn-custom btn-glass" style="cursor: default;">
                            <i class="bi bi-shield-check text-primary"></i> Verified Campus Protection
                        </div>
                        <div class="btn-custom btn-glass" style="cursor: default;">
                            <i class="bi bi-incognito text-info"></i> 100% Confidential Reporting
                        </div>
                        <div class="btn-custom btn-glass" style="cursor: default;">
                            <i class="bi bi-broadcast text-success"></i> Real-Time Security Dispatch
                        </div>
                    </div>

                    <!-- Live Trust Indicators -->
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="trust-stat-box">
                                <div class="trust-stat-num text-primary">24/7</div>
                                <div class="trust-stat-lbl">Patrol Command</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="trust-stat-box">
                                <div class="trust-stat-num text-success">&lt;3m</div>
                                <div class="trust-stat-lbl">Emergency Response</div>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="trust-stat-box">
                                <div class="trust-stat-num text-warning">100%</div>
                                <div class="trust-stat-lbl">Encrypted Reports</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="row g-4">
                        <div class="col-sm-6">
                            <div class="feature-card">
                                <div class="feature-icon icon-red">
                                    <i class="bi bi-broadcast"></i>
                                </div>
                                <!-- <h3 class="feature-title">Emergency SOS</h3> -->
                                <p class="feature-desc">Single-tap emergency beacon with GPS coordinates dispatched straight to campus quick-response vehicles.</p>
                            </div>
                        </div>
                        <div class="col-sm-6 mt-sm-5">
                            <div class="feature-card">
                                <div class="feature-icon icon-purple">
                                    <i class="bi bi-incognito"></i>
                                </div>
                                <h3 class="feature-title">Anonymous Reporting</h3>
                                <p class="feature-desc">Report ragging, harassment, or misconduct with complete confidentiality and end-to-end identity masking.</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="feature-card">
                                <div class="feature-icon icon-blue">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </div>
                                <h3 class="feature-title">Live Safety Map</h3>
                                <p class="feature-desc">Interactive campus radar highlighting emergency phone poles, security gates, and illuminated walkways.</p>
                            </div>
                        </div>
                        <div class="col-sm-6 mt-sm-5">
                            <div class="feature-card">
                                <div class="feature-icon icon-amber">
                                    <i class="bi bi-heart-pulse-fill"></i>
                                </div>
                                <h3 class="feature-title">Counseling & Welfare</h3>
                                <p class="feature-desc">Direct private consultation pathways with psychological counselors and designated student welfare officers.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- DIRECT EMERGENCY CONNECT SECTION -->
    <section id="emergency-connect" style="background-color: #0c1427; border-top: 1px solid rgba(255,255,255,0.06); border-bottom: 1px solid rgba(255,255,255,0.06); padding: 90px 0;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.8rem;">
                    🚨 Immediate Campus Reach
                </span>
                <h2 class="display-6 fw-bold text-white mt-2 mb-3">Campus Emergency & Safety Directory</h2>
                <p class="text-secondary mx-auto" style="max-width: 600px; font-size: 1.05rem;">
                    Reach out directly to verified campus security units, medical emergency staff, warden desks, and student welfare officers.
                </p>
            </div>

            <div class="row g-4">
                @{
                    var contacts = ViewBag.EmergencyContacts as List<SurakshaSetu.Models.EmergencyContact>;
                    if (contacts != null && contacts.Any())
                    {
                        foreach (var contact in contacts)
                        {
                            <div class="col-md-6 col-lg-4">
                                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; transition: all 0.3s ease; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.75rem;">
                                                @(contact.Category ?? "Campus Helpline")
                                            </span>
                                            @if (contact.Is24x7)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.72rem;">
                                                    <i class="bi bi-clock-fill me-1"></i> 24x7 Active
                                                </span>
                                            }
                                        </div>
                                        <h5 class="fw-bold text-white mb-1">@contact.Name</h5>
                                        <div class="text-secondary small mb-3">@contact.Department &bull; @contact.Role</div>
                                    </div>
                                    <div class="d-flex align-items-center justify-content-between pt-3 border-top border-secondary border-opacity-25 mt-2">
                                        <div class="fw-bold text-warning font-monospace fs-6">
                                            📞 @contact.PhoneNumber
                                        </div>
                                        <a href="tel:@contact.PhoneNumber" class="btn btn-sm btn-outline-light px-3 py-1 fw-bold rounded-pill" style="font-size: 0.8rem;">
                                            Call Now
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Static Fallback Campus Contacts -->
                        <div class="col-md-4">
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; height: 100%;">
                                <div class="badge bg-danger-subtle text-danger px-2 py-1 mb-3">Security Command</div>
                                <h5 class="fw-bold text-white mb-1">Campus Main Security</h5>
                                <div class="text-secondary small mb-3">Central Command Control Room</div>
                                <div class="fw-bold text-warning font-monospace fs-6">📞 +91 9876543210</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; height: 100%;">
                                <div class="badge bg-info-subtle text-info px-2 py-1 mb-3">Medical Unit</div>
                                <h5 class="fw-bold text-white mb-1">Uni Hospital Emergency</h5>
                                <div class="text-secondary small mb-3">24/7 Ambulance & Trauma Ward</div>
                                <div class="fw-bold text-warning font-monospace fs-6">📞 +91 8765432109</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; padding: 24px; height: 100%;">
                                <div class="badge bg-purple-subtle text-primary px-2 py-1 mb-3">Women's Safety</div>
                                <h5 class="fw-bold text-white mb-1">Women Safety Cell</h5>
                                <div class="text-secondary small mb-3">Confidential Assistance Desk</div>
                                <div class="fw-bold text-warning font-monospace fs-6">📞 +91 7654321098</div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Campus Locations & Reporting Categories Preview -->
            <div class="mt-5 p-4 rounded-4" style="background: rgba(30, 41, 59, 0.4); border: 1px solid rgba(255,255,255,0.08);">
                <div class="row align-items-center g-4">
                    <div class="col-lg-6">
                        <h5 class="fw-bold text-white d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-geo-alt-fill text-primary"></i> Live Verified Safe Zones & Locations
                        </h5>
                        <p class="text-secondary small mb-3">
                            Campus zones mapped with emergency SOS call points, CCTV security coverage, and medical assistance:
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                var locations = ViewBag.CampusLocations as List<SurakshaSetu.Models.CampusLocation>;
                                if (locations != null && locations.Any())
                                {
                                    foreach (var loc in locations)
                                    {
                                        <span class="badge bg-dark text-light border border-secondary border-opacity-50 px-2 py-2" style="font-size: 0.75rem;">
                                            🏫 @loc.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-dark text-light border px-2 py-1">LPU Main Gate</span>
                                    <span class="badge bg-dark text-light border px-2 py-1">Central Innovation Hub</span>
                                    <span class="badge bg-dark text-light border px-2 py-1">Uni Hospital</span>
                                    <span class="badge bg-dark text-light border px-2 py-1">Block 32 Cafe</span>
                                    <span class="badge bg-dark text-light border px-2 py-1">Girls Hostel 1</span>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h5 class="fw-bold text-white d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-tags-fill text-warning"></i> Safety Reporting Categories
                        </h5>
                        <p class="text-secondary small mb-3">
                            Direct resolution pipelines assigned to designated campus welfare and security authorities:
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            @{
                                var cats = ViewBag.IncidentCategories as List<SurakshaSetu.Models.IncidentCategory>;
                                if (cats != null && cats.Any())
                                {
                                    foreach (var cat in cats)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-2" style="font-size: 0.75rem;">
                                            🛡️ @cat.Name
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">Harassment</span>
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">Theft</span>
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">Medical Emergency</span>
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">Infrastructure Issue</span>
                                    <span class="badge bg-primary-subtle text-primary border px-2 py-1">Hostel Food Safety</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS SECTION -->
    <section style="padding: 90px 0; background-color: #0b1120;">
        <div class="container">
            <div class="text-center mb-5">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-bold text-uppercase" style="letter-spacing: 1px; font-size: 0.8rem;">
                    Step-by-Step Protocol
                </span>
                <h2 class="display-6 fw-bold text-white mt-2 mb-3">How SurakshaSetu Protects You</h2>
                <p class="text-secondary mx-auto" style="max-width: 550px; font-size: 1rem;">
                    From silent mobile SOS triggers to live quick-response dispatch, here is how our ecosystem works:
                </p>
            </div>

            <div class="row g-4">
                <div class="col-md-4">
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 18px; padding: 32px; text-align: center; height: 100%;">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(239, 68, 68, 0.15); color: #ef4444; font-size: 1.8rem;">
                            <i class="bi bi-broadcast"></i>
                        </div>
                        <h4 class="fw-bold text-white mb-2">1. Instant SOS Trigger</h4>
                        <p class="text-secondary" style="font-size: 0.92rem; line-height: 1.6;">
                            Single tap on the mobile or desktop portal immediately packages your verified GPS coordinates and alerts Security Command without making an audible call.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 18px; padding: 32px; text-align: center; height: 100%;">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(59, 130, 246, 0.15); color: #3b82f6; font-size: 1.8rem;">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h4 class="fw-bold text-white mb-2">2. Live Officer Dispatch</h4>
                        <p class="text-secondary" style="font-size: 0.92rem; line-height: 1.6;">
                            Nearest patrolling security units, quick response teams, or medical first responders are routed directly to your building location in under 3 minutes.
                        </p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); border-radius: 18px; padding: 32px; text-align: center; height: 100%;">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 64px; height: 64px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); color: #10b981; font-size: 1.8rem;">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <h4 class="fw-bold text-white mb-2">3. Zero-Trace Confidentiality</h4>
                        <p class="text-secondary" style="font-size: 0.92rem; line-height: 1.6;">
                            Anonymous reporting assigns a cryptographic Tracking PIN. Track investigations, talk with officers, and rate case resolution without revealing your name.
                        </p>
                    </div>
                </div>
