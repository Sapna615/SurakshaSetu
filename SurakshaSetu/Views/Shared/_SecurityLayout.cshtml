@using Microsoft.AspNetCore.Identity
@using SurakshaSetu.Models
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SurakshaSetu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            background: radial-gradient(circle at top left, #1e293b 0%, #080e18 60%) !important;
            background-color: #080e18 !important;
            background-attachment: fixed !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            overflow-x: hidden;
            color: #ffffff;
        }
        .wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            background: transparent;
        }
        .sidebar {
            width: 260px;
            background: #0d1726;
            backdrop-filter: blur(20px);
            border-right: 1px solid #1e2d42;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100%;
            z-index: 100;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
        }
        .sidebar-header {
            padding: 25px 20px;
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-label {
            padding: 0 20px;
            margin-bottom: 15px;
            font-size: 0.65rem;
            font-weight: 700;
            color: #94a3b8;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }
        .sidebar-menu li {
            padding: 4px 15px;
        }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 15px;
            color: #cbd5e1;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .sidebar-menu a:hover {
            background-color: rgba(59, 130, 246, 0.15);
            color: #ffffff;
        }
        .sidebar-menu a.active {
            background: linear-gradient(135deg, rgba(37,99,235,0.3) 0%, rgba(37,99,235,0.6) 100%) !important;
            color: #ffffff !important;
            font-weight: 700;
            border: 1px solid rgba(96,165,250,0.4);
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        }
        .main-content {
            flex-grow: 1;
            margin-left: 260px;
            display: flex;
            flex-direction: column;
            background: transparent;
            min-height: 100vh;
        }
        .top-header {
            height: 64px;
            background: #0d1726;
            backdrop-filter: blur(16px);
            border-bottom: 1px solid #1e2d42;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .breadcrumb-title {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .breadcrumb-title span {
            font-weight: 700;
            color: #ffffff;
        }
        .user-profile {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #ffffff;
        }
        .content-area {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            background: transparent;
        }

        /* Deep Navy & Charcoal Theme Overrides for Security Views */
        .card, .card.bg-dark-glass, .bg-dark-glass {
            background-color: #111a28 !important;
            background: #111a28 !important;
            border: 1px solid #1e2d42 !important;
            color: #f8fafc !important;
            border-radius: 14px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35) !important;
        }

        .card-header, .card-header.bg-dark-glass, .card-header.bg-dark-subtle {
            background-color: #0d1726 !important;
            background: #0d1726 !important;
            border-bottom: 1px solid #1e2d42 !important;
            color: #ffffff !important;
        }

        .card-body {
            background-color: transparent !important;
            color: #e2e8f0 !important;
        }

        /* Bootstrap Table Overrides */
        .table {
            --bs-table-bg: transparent !important;
            --bs-table-accent-bg: transparent !important;
            --bs-table-striped-bg: transparent !important;
            --bs-table-active-bg: #17263d !important;
            --bs-table-hover-bg: #17263d !important;
            --bs-table-color: #f8fafc !important;
            --bs-table-hover-color: #ffffff !important;
            --bs-table-border-color: #1e2d42 !important;
            color: #f8fafc !important;
            border-color: #1e2d42 !important;
            background-color: transparent !important;
        }

        .table > :not(caption) > * > * {
            background-color: transparent !important;
            color: #cbd5e1 !important;
            box-shadow: none !important;
            border-bottom-color: #1e2d42 !important;
        }

        .table thead th,
        .table-light,
        .table-light > th,
        .table-light > td {
            --bs-table-bg: #0d1726 !important;
            --bs-table-color: #94a3b8 !important;
            background-color: #0d1726 !important;
            color: #94a3b8 !important;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.78rem;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #1e2d42 !important;
            box-shadow: none !important;
        }

        .table tbody tr {
            background-color: transparent !important;
            color: #f8fafc !important;
            border-bottom: 1px solid #172437 !important;
        }

        .table-hover > tbody > tr:hover > * {
            --bs-table-accent-bg: #17263d !important;
            background-color: #17263d !important;
            color: #ffffff !important;
            box-shadow: none !important;
        }

        .table td, .table th {
            color: #cbd5e1 !important;
        }

        .btn-outline-primary {
            border-color: #2563eb !important;
            color: #60a5fa !important;
            background-color: #1e3a5f !important;
            font-weight: 600;
        }

        .btn-outline-primary:hover {
            background-color: #2563eb !important;
            color: #ffffff !important;
            border-color: #3b82f6 !important;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <nav class="sidebar">
            <div class="sidebar-header" style="padding-bottom: 5px;">
                <div class="d-flex align-items-center gap-2">
                    <span style="color: #dc2626; font-size: 1.5rem;">🛡️</span> 
                    <div style="line-height: 1;">
                        <div style="font-size: 1.1rem; font-weight: 800; color: #111827;">SurakshaSetu</div>
                        <div style="font-size: 0.6rem; font-weight: 700; color: #9ca3af; letter-spacing: 1px; margin-top: 3px;">CAMPUS SAFETY</div>
                    </div>
                </div>
            </div>
            
            <ul class="sidebar-menu" style="margin-top: 20px;">
                <li><a href="/Security/Dashboard" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" ? "active" : "")"><span style="color:#3b82f6;">🏠</span> Dashboard</a></li>
                <li><a href="/Security/IncidentQueue" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "IncidentQueue" ? "active" : "")"><span>📋</span> Incident Queue</a></li>
                <li><a href="/Security/MyCases" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "MyCases" ? "active" : "")"><span>🛡️</span> My Assigned Cases</a></li>
                <li><a href="/Security/ActiveSOS" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "ActiveSOS" ? "active" : "")"><span class="text-danger font-weight-bold">🚨</span> <span class="text-danger font-weight-bold">Active SOS</span></a></li>
                <li><a href="/Safety/Map"><span>🗺️</span> Safety Map</a></li>
                <li><a href="/EmergencyContact"><span>📞</span> Emergency Contacts Directory</a></li>
                <li><a href="/Security/Infrastructure" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Infrastructure" ? "active" : "")"><span>🚧</span> Infrastructure Issues</a></li>
                <li><a href="/Security/EmergencyRequests" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "EmergencyRequests" ? "active" : "")"><span>📞</span> Emergency Requests</a></li>
                <li style="margin-top: 15px;">
                    <a href="/Security/Profile" class="@(ViewContext.RouteData.Values["Action"]?.ToString() == "Profile" ? "active" : "")"><span>👤</span> My Profile</a>
                </li>
            </ul>

            <div style="padding: 20px; margin-top: auto;">
                <div style="background-color: #111a28; border: 1px solid #1e2d42; border-radius: 12px; padding: 15px;">
                    <div style="font-weight: 800; font-size: 0.85rem; color: #ffffff; margin-bottom: 8px;">Need immediate help?</div>
                    <div class="font-size: 0.75rem; color: #94a3b8; margin-bottom: 15px; line-height: 1.4;">Use Emergency SOS for urgent campus assistance.</div>
                    <button class="btn btn-sm w-100 fw-bold btn-sos-trigger" style="background-color: rgba(220, 38, 38, 0.25); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); user-select: none;">🚨 Emergency SOS</button>
                </div>
                <div style="margin-top: 15px;">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#quickHelpModal" style="color: #94a3b8; text-decoration: none; font-size: 0.8rem; display: flex; align-items: center; gap: 8px;">
                        <span>❓</span> Quick Help
                    </a>
                </div>
            </div>
        </nav>
        
        <div class="main-content">
            <header class="top-header">
                <div class="breadcrumb-title">Security Operations / <span>@ViewData["Title"]</span></div>
                <div class="user-profile">
                    <div class="dropdown" style="display:inline-block; margin-right: 15px;">
                        <span id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="color:#f59e0b; cursor:pointer; font-size: 1.2rem; position: relative;">
                            🔔
                            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; display: none;">
                                0
                            </span>
                        </span>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="notificationDropdown" style="width: 300px; padding: 0; background-color: #0d1726; border: 1px solid #1e2d42;">
                            <li class="dropdown-header fw-bold" style="background-color: #0d1726; border-bottom: 1px solid #1e2d42; padding: 10px 15px; color: #ffffff;">Active SOS Alerts</li>
                            <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                                <li class="p-3 text-center text-muted" id="noNotificationsMsg"><small>No active emergency alerts.</small></li>
                            </div>
                            <li><a class="dropdown-item text-center fw-bold text-primary py-2" style="border-top: 1px solid #1e2d42; font-size: 0.85rem;" href="/Security/ActiveSOS">View All Active SOS</a></li>
                        </ul>
                    </div>
                    <span>
                        @{
                            var user = await UserManager.GetUserAsync(User);
                            var displayName = ViewData["UserName"] ?? user?.FullName ?? User.Identity?.Name;
                        }
                        @displayName - Security
                    </span>
                    <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-link text-dark p-0 text-decoration-none" style="font-size: 0.85rem; font-weight:600;">Logout</button>
                    </form>
                </div>
            </header>
            
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>
    
    <!-- SOS Activation Modal -->
    <div class="modal fade" id="sosModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border: 2px solid #ef4444; border-radius: 18px; overflow: hidden; background: #0d1726; box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%); border-bottom: 1px solid rgba(239, 68, 68, 0.4); padding: 18px 22px;">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2 mb-0" style="color: #ffffff !important; font-size: 1.15rem;">
                        <span class="spinner-grow spinner-grow-sm text-light" role="status"></span>
                        🚨 Emergency SOS Broadcast Sent
                    </h5>
                </div>
                <div class="modal-body p-4" style="background: #0d1726;">
                    <div class="d-flex align-items-center gap-3 p-3 mb-3" style="background: linear-gradient(135deg, rgba(220, 38, 38, 0.25) 0%, rgba(153, 27, 27, 0.35) 100%); border: 1px solid rgba(239, 68, 68, 0.5); border-radius: 12px;">
                        <i class="bi bi-broadcast text-danger fs-2" style="color: #f87171 !important;"></i>
                        <div style="font-size: 0.92rem; line-height: 1.45; color: #ffffff;">
                            <strong class="d-block mb-1" style="color: #fca5a5 !important; font-size: 0.98rem; font-weight: 800;">Direct High-Priority Alert Sent to Security!</strong>
                            <span style="color: #f1f5f9 !important;">Security Command Center has received your live emergency notification and dispatched response teams.</span>
                        </div>
                    </div>
                    
                    <div class="card mb-4" style="background: #111a28 !important; border: 1px solid #1e2d42 !important; border-radius: 14px; box-shadow: 0 6px 18px rgba(0,0,0,0.3);">
                        <div class="card-body p-3">
                            <div class="mb-3"><small class="text-uppercase fw-bold" style="color: #94a3b8 !important; letter-spacing: 0.5px; font-size: 0.75rem;">Status:</small><br><span id="sosStatusTxt" class="fw-bold" style="color: #38bdf8 !important; font-size: 1.05rem;">Emergency Request Created</span></div>
                            <div class="mb-3"><small class="text-uppercase fw-bold" style="color: #94a3b8 !important; letter-spacing: 0.5px; font-size: 0.75rem;">Location:</small><br><span id="sosLocationTxt" class="fw-bold text-white" style="font-size: 1.05rem;">Locating...</span></div>
                            <div class="mb-3"><small class="text-uppercase fw-bold" style="color: #94a3b8 !important; letter-spacing: 0.5px; font-size: 0.75rem;">Request ID:</small><br><span id="sosRequestIdTxt" class="badge font-monospace px-3 py-2 mt-1" style="background-color: #ef4444 !important; color: #ffffff !important; font-size: 0.9rem; font-weight: 800; border-radius: 6px;">SOS-...</span></div>
                            <div><small class="text-uppercase fw-bold" style="color: #94a3b8 !important; letter-spacing: 0.5px; font-size: 0.75rem;">Created:</small><br><span id="sosTimeTxt" style="color: #cbd5e1 !important; font-size: 0.9rem;"></span></div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn py-2 fw-bold" data-bs-dismiss="modal" onclick="acknowledgeSOSModal()" style="background: #1e293b; color: #f8fafc; border: 1px solid #334155; border-radius: 10px;">
                            <i class="bi bi-check-circle me-1" style="color: #38bdf8;"></i> Acknowledge & Keep SOS Active
                        </button>
                        <button type="button" class="btn py-2 fw-bold" onclick="cancelSOS()" style="background: transparent; color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4); border-radius: 10px;">
                            <i class="bi bi-x-circle me-1"></i> Cancel Emergency SOS
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SOS Cancel Confirmation Modal -->
    <div class="modal fade" id="cancelSosModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">Cancel Emergency Request?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this SOS request?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" onclick="keepSosActive()">Keep SOS Active</button>
                    <button type="button" class="btn btn-danger fw-bold" onclick="confirmCancelSOS()">Cancel SOS</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentSosRequestId = null;
        let sosModal = null;
        let cancelSosModal = null;

        document.addEventListener("DOMContentLoaded", function() {
            sosModal = new bootstrap.Modal(document.getElementById('sosModal'));
            cancelSosModal = new bootstrap.Modal(document.getElementById('cancelSosModal'));
            
            // Wire up all SOS buttons (sidebar and any page buttons)
            document.querySelectorAll('.btn-sos-trigger').forEach(btn => {
                
                // Implement hold-to-activate (3 seconds)
                let pressTimer;
                let isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
                
                const startPress = (e) => {
                    if (e.type === 'mousedown' && e.button !== 0) return; // Only left click
                    btn.classList.add('active-press');
                    btn.innerHTML = '🚨 HOLD 3 SECONDS...';
                    pressTimer = window.setTimeout(activateSOS, 3000);
                };
                
                const cancelPress = () => {
                    clearTimeout(pressTimer);
                    btn.classList.remove('active-press');
                    btn.innerHTML = '🚨 Emergency SOS';
                };
                
                btn.addEventListener('mousedown', startPress);
                btn.addEventListener('mouseup', cancelPress);
                btn.addEventListener('mouseleave', cancelPress);
                
                btn.addEventListener('touchstart', startPress, {passive: true});
                btn.addEventListener('touchend', cancelPress);
                btn.addEventListener('touchcancel', cancelPress);
            });

            // Check if there's an active SOS on page load
            checkActiveSOS();
        });

        function checkActiveSOS() {
            fetch('/api/sos/status')
                .then(r => r.json())
                .then(data => {
                    if(data.active) {
                        currentSosRequestId = data.sos.requestId;
                        // Keep currentSosRequestId in background; do not auto popup modal on page load
                    }
                }).catch(e => console.error("SOS Status Error", e));
        }

        function acknowledgeSOSModal() {
            if (currentSosRequestId) {
                sessionStorage.setItem('dismissed_sos_id', currentSosRequestId);
            }
        }

        function activateSOS() {
            // Instantly show modal to acknowledge activation
            sosModal.show();
            document.getElementById('sosLocationTxt').innerText = 'Requesting location...';
            document.getElementById('sosTimeTxt').innerText = new Date().toLocaleString();
            
            // Try to get location
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    pos => {
                        sendSOSRequest(pos.coords.latitude, pos.coords.longitude, `Lat: ${pos.coords.latitude.toFixed(4)}, Lng: ${pos.coords.longitude.toFixed(4)}`);
                    },
                    err => {
                        sendSOSRequest(null, null, "Location unavailable (Permission denied or failed)");
                    },
                    { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                );
            } else {
                sendSOSRequest(null, null, "Location not supported by browser");
            }
        }

        function sendSOSRequest(lat, lng, desc) {
            document.getElementById('sosLocationTxt').innerText = desc;
            
            fetch('/api/sos/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Latitude: lat, Longitude: lng, LocationDescription: desc })
            })
            .then(async r => {
                const data = await r.json();
                if(data.success) {
                    showSOSPopup(data.sos);
                } else {
                    alert("Error: " + (data.message || "We couldn't create the emergency request.") + (data.inner ? "\n" + data.inner : ""));
                }
            })
            .catch(e => {
                alert("We couldn't create the emergency request. Please try again or call security immediately.");
            });
        }

        function showSOSPopup(sos) {
            currentSosRequestId = sos.requestId;
            document.getElementById('sosRequestIdTxt').innerText = sos.requestId;
            document.getElementById('sosStatusTxt').innerText = sos.status === 'Created' ? 'Emergency Request Created' : sos.status;
            document.getElementById('sosLocationTxt').innerText = sos.locationDescription || 'Location unavailable';
            document.getElementById('sosTimeTxt').innerText = new Date(sos.createdAt).toLocaleString();
            sosModal.show();
        }

        function cancelSOS() {
            sosModal.hide();
            cancelSosModal.show();
        }

        function keepSosActive() {
            cancelSosModal.hide();
            sosModal.show();
        }

        function confirmCancelSOS() {
            if(!currentSosRequestId) return;
            
            fetch(`/api/sos/cancel/${currentSosRequestId}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    sessionStorage.removeItem('dismissed_sos_id');
                    cancelSosModal.hide();
                    currentSosRequestId = null;
                    alert("SOS request cancelled.\nStatus: Cancelled");
                }
            });
        }
    </script>
    <style>
        .active-press {
            background-color: #991b1b !important;
            color: white !important;
            transform: scale(0.95);
            transition: all 3s linear;
        }
        .notification-item { border-bottom: 1px solid #1e2d42; padding: 10px 15px; color: #f8fafc; }
        .notification-item:hover { background-color: #17263d !important; }
        .pulse-animation { animation: pulse-red 2s infinite; }
        @@keyframes pulse-red { 0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.7); } 70% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(220, 38, 38, 0); } 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); } }
    </style>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Start polling for active SOS alerts every 3 seconds for instant response
            pollActiveSOS();
            setInterval(pollActiveSOS, 3000);
        });

        let previousAlertCount = 0;
        
        function pollActiveSOS() {
            fetch('/api/sos/active')
                .then(r => {
                    if (!r.ok) return null;
                    return r.json();
                })
                .then(data => {
                    if (!data) return;
                    const badge = document.getElementById('notificationBadge');
                    const list = document.getElementById('notificationList');
                    const noMsg = document.getElementById('noNotificationsMsg');
                    const bell = document.getElementById('notificationDropdown');
                    
                    if(data.count > 0 || (data.cancelled && data.cancelled.length > 0)) {
                        const totalBadgeCount = data.count;
                        if (totalBadgeCount > 0) {
                            badge.innerText = totalBadgeCount;
                            badge.style.display = 'block';
                            bell.classList.add('pulse-animation');
                        } else {
                            badge.style.display = 'none';
                            bell.classList.remove('pulse-animation');
                        }
                        
                        list.innerHTML = '';
                        if (data.alerts && data.alerts.length > 0) {
                            data.alerts.forEach(alert => {
                                const time = new Date(alert.time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                                list.innerHTML += `
                                    <a href="/Security/IncidentDetails/${alert.id}" class="text-decoration-none text-dark d-block notification-item bg-danger-subtle">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-bold text-danger">🚨 SOS Alert (Active)</span>
                                            <small class="text-muted">${time}</small>
                                        </div>
                                        <div style="font-size: 0.8rem; line-height: 1.2;">
                                            <strong>Location:</strong> ${alert.location}<br>
                                            <strong>ID:</strong> <span class="badge bg-danger text-white fw-bold">${alert.reportId}</span>
                                        </div>
                                    </a>
                                `;
                            });
                        }

                        if (data.cancelled && data.cancelled.length > 0) {
                            data.cancelled.forEach(item => {
                                const time = new Date(item.time).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
                                list.innerHTML += `
                                    <a href="/Security/IncidentDetails/${item.id}" class="text-decoration-none text-white d-block notification-item" style="background-color: #111a28; opacity: 0.95;">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="fw-bold text-secondary">🚫 SOS Cancelled by User</span>
                                            <small class="text-muted">${time}</small>
                                        </div>
                                        <div style="font-size: 0.8rem; line-height: 1.2;">
                                            <strong>Location:</strong> ${item.location}<br>
                                            <strong>ID:</strong> <span class="badge bg-secondary text-white fw-bold">${item.reportId}</span>
                                            <span class="badge bg-warning text-dark ms-1">Cancelled</span>
                                        </div>
                                    </a>
                                `;
                            });
                        }
                    } else {
                        badge.style.display = 'none';
                        bell.classList.remove('pulse-animation');
                        list.innerHTML = '<li class="p-3 text-center text-muted" id="noNotificationsMsg"><small>No active emergency alerts.</small></li>';
                    }
                    
                    // If alert count decreased (e.g. student cancelled SOS or officer resolved it) while looking at dashboard, reload to update table
                    if (previousAlertCount > 0 && data.count !== previousAlertCount && window.location.pathname.toLowerCase().includes('/security/dashboard')) {
                        window.location.reload();
                    }
                    
                    previousAlertCount = data.count;
                })
                .catch(e => console.error("Error polling SOS:", e));
        }
    </script>
    <partial name="_QuickHelpModal" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
