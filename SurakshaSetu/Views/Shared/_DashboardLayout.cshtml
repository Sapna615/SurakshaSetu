@using Microsoft.AspNetCore.Identity
@using SurakshaSetu.Models
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SurakshaSetu</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body {
            background-color: #0b1120 !important;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            margin: 0;
            overflow-x: hidden;
            color: #f8fafc;
        }
        .wrapper {
            display: flex;
            width: 100%;
            min-height: 100vh;
            background-color: #0b1120;
        }
        .sidebar {
            width: 260px;
            background: #0f172a;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100%;
            z-index: 100;
            box-shadow: 4px 0 24px rgba(0, 0, 0, 0.4);
        }
        .sidebar-header {
            padding: 25px 20px;
            font-size: 1.25rem;
            font-weight: 700;
            color: #f8fafc;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .sidebar-label {
            padding: 0 20px;
            margin-bottom: 15px;
            font-size: 0.65rem;
            font-weight: 700;
            color: #64748b;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }
        .sidebar-menu li {
            padding: 4px 15px;
        }
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 15px;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .sidebar-menu a:hover {
            background-color: #1e293b;
            color: #ffffff;
        }
        .sidebar-menu a.active {
            background: linear-gradient(135deg, rgba(37,99,235,0.2) 0%, rgba(37,99,235,0.4) 100%) !important;
            color: #60a5fa !important;
            font-weight: 700;
            border: 1px solid rgba(96,165,250,0.3);
        }
        .main-content {
            flex-grow: 1;
            margin-left: 260px;
            display: flex;
            flex-direction: column;
            background: #0b1120;
            min-height: 100vh;
        }
        .top-header {
            height: 64px;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 40px;
            position: sticky;
            top: 0;
            z-index: 99;
        }
        .breadcrumb-title {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 500;
        }
        .breadcrumb-title span {
            font-weight: 700;
            color: #f8fafc;
        }
        .user-profile {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            color: #f8fafc;
        }
        .content-area {
            padding: 40px;
            max-width: 1200px;
            margin: 0 auto;
            width: 100%;
            background-color: #0b1120;
        }
    </style>
</head>
<body>
    <div class="wrapper">
        <nav class="sidebar">
            <div class="sidebar-header" style="padding-bottom: 5px;">
                <div class="d-flex align-items-center gap-2">
                    <span style="color: #dc2626; font-size: 1.5rem;">🛡️</span> 
                    <div style="line-height: 1;">
                        <div style="font-size: 1.1rem; font-weight: 800; color: #111827;">SurakshaSetu</div>
                        <div style="font-size: 0.6rem; font-weight: 700; color: #9ca3af; letter-spacing: 1px; margin-top: 3px;">CAMPUS SAFETY</div>
                    </div>
                </div>
            </div>
            
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
            }
            <ul class="sidebar-menu" style="margin-top: 20px;">
                <li><a href="/Student/Dashboard" class="@(controller == "Student" ? "active" : "")" style="@(controller == "Student" ? "background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; font-weight: 700; box-shadow: 0 2px 4px rgba(37,99,235,0.08);" : "")"><i class="bi bi-grid-1x2-fill me-2" style="@(controller == "Student" ? "color:#2563eb;" : "color:#6b7280;")"></i> Dashboard</a></li>
                <li><a href="@Url.Action("MyReports", "IncidentReport")"><i class="bi bi-clipboard2-check me-2" style="color:#6b7280;"></i> My Reports</a></li>
                <li><a href="/Safety/Map" class="@(controller == "SafetyMap" ? "active" : "")" style="@(controller == "SafetyMap" ? "background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; font-weight: 700;" : "")"><i class="bi bi-geo-alt-fill me-2" style="@(controller == "SafetyMap" ? "color:#2563eb;" : "color:#6b7280;")"></i> Safety Map</a></li>
                <li style="position: relative;">
                    <a href="/SafetyAlert" class="@(controller == "SafetyAlert" ? "active" : "")" style="@(controller == "SafetyAlert" ? "background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; font-weight: 700;" : "")"><i class="bi bi-bell-fill me-2" style="@(controller == "SafetyAlert" ? "color:#2563eb;" : "color:#6b7280;")"></i> Safety Alerts</a>
                </li>
                <li><a href="/EmergencyContact" class="@(controller == "EmergencyContact" ? "active" : "")" style="@(controller == "EmergencyContact" ? "background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); color: #1d4ed8; font-weight: 700;" : "")"><i class="bi bi-telephone-fill me-2" style="@(controller == "EmergencyContact" ? "color:#2563eb;" : "color:#6b7280;")"></i> Emergency Contacts</a></li>
                <br/>
                <li><a href="/Student/Profile"><i class="bi bi-person-circle me-2" style="color:#6b7280;"></i> My Profile</a></li>
            </ul>

            <div style="padding: 20px; margin-top: auto;">
                <div style="background-color: #f9fafb; border: 1px solid #f3f4f6; border-radius: 8px; padding: 15px;">
                    <div style="font-weight: 800; font-size: 0.85rem; color: #111827; margin-bottom: 8px;">Need immediate help?</div>
                    <div class="font-size: 0.75rem; color: #6b7280; margin-bottom: 15px; line-height: 1.4;">Use Emergency SOS for urgent campus assistance.</div>
                    <button class="btn btn-sm w-100 fw-bold btn-sos-trigger" style="background-color: #fef2f2; color: #dc2626; border: 1px solid #fee2e2; user-select: none;">🚨 Emergency SOS</button>
                </div>
                <div style="margin-top: 15px;">
                    <a href="#" data-bs-toggle="modal" data-bs-target="#quickHelpModal" style="color: #6b7280; text-decoration: none; font-size: 0.8rem; display: flex; align-items: center; gap: 8px;">
                        <span>❓</span> Quick Help
                    </a>
                </div>
            </div>
        </nav>
        
        <div class="main-content">
            <header class="top-header">
                <div class="breadcrumb-title">Student Portal / <span>@ViewData["Title"]</span></div>
                <div class="user-profile">
                    <span style="color:#f59e0b; cursor:pointer;">🔔</span>
                    <span>
                        @{
                            var user = await UserManager.GetUserAsync(User);
                            var displayName = ViewData["UserName"] ?? user?.FullName ?? User.Identity?.Name;
                        }
                        @displayName - Student
                    </span>
                    <form class="form-inline m-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-link text-dark p-0 text-decoration-none" style="font-size: 0.85rem; font-weight:600;">Logout</button>
                    </form>
                </div>
            </header>
            
            <div class="content-area">
                @RenderBody()
            </div>
        </div>
    </div>
    
    <!-- SOS Activation Modal -->
    <div class="modal fade" id="sosModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border: 2px solid #dc2626; border-radius: 16px; overflow: hidden; box-shadow: 0 20px 40px rgba(220, 38, 38, 0.2);">
                <div class="modal-header text-white" style="background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <span class="spinner-grow spinner-grow-sm text-light" role="status"></span>
                        🚨 Emergency SOS Broadcast Sent
                    </h5>
                </div>
                <div class="modal-body p-4 bg-light">
                    <!-- Direct Alert Confirmation to Security -->
                    <div class="alert alert-danger d-flex align-items-center gap-3 border-0 shadow-sm mb-3" style="background-color: #fee2e2; color: #991b1b; border-radius: 12px;">
                        <i class="bi bi-broadcast text-danger fs-3"></i>
                        <div style="font-size: 0.9rem; line-height: 1.4;">
                            <strong class="d-block mb-1">Direct High-Priority Alert Sent to Security!</strong>
                            Security Command Center has received your live emergency notification and dispatched response teams.
                        </div>
                    </div>
                    
                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
                        <div class="card-body">
                            <div class="mb-2"><small class="text-muted text-uppercase fw-bold">Live Status:</small><br><span id="sosStatusTxt" class="fw-bold text-danger">🚨 Security Dispatched & Alerted</span></div>
                            <div class="mb-2"><small class="text-muted text-uppercase fw-bold">Dispatched Location:</small><br><span id="sosLocationTxt" class="fw-bold text-dark">Locating...</span></div>
                            <div class="mb-2"><small class="text-muted text-uppercase fw-bold">Emergency Request ID:</small><br><span id="sosRequestIdTxt" class="badge bg-danger text-white font-monospace px-2 py-1">SOS-...</span></div>
                            <div><small class="text-muted text-uppercase fw-bold">Timestamp:</small><br><span id="sosTimeTxt" class="text-muted small"></span></div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-secondary py-2 fw-bold" data-bs-dismiss="modal">
                            <i class="bi bi-check-circle me-1"></i> Acknowledge & Keep SOS Active
                        </button>
                        <button type="button" class="btn btn-outline-danger py-2 fw-bold" onclick="cancelSOS()">
                            <i class="bi bi-x-circle me-1"></i> Cancel Emergency SOS
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SOS Cancel Confirmation Modal -->
    <div class="modal fade" id="cancelSosModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger">Cancel Emergency Request?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to cancel this SOS request?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary fw-bold" onclick="keepSosActive()">Keep SOS Active</button>
                    <button type="button" class="btn btn-danger fw-bold" onclick="confirmCancelSOS()">Cancel SOS</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let currentSosRequestId = null;
        let sosModal = null;
        let cancelSosModal = null;

        document.addEventListener("DOMContentLoaded", function() {
            sosModal = new bootstrap.Modal(document.getElementById('sosModal'));
            cancelSosModal = new bootstrap.Modal(document.getElementById('cancelSosModal'));
            
            // Wire up all SOS buttons (instant activation on click for smooth emergency demo)
            document.querySelectorAll('.btn-sos-trigger').forEach(btn => {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    activateSOS();
                });
            });

            // Check if there's an active SOS on page load
            checkActiveSOS();
        });

        function checkActiveSOS() {
            fetch('/api/sos/status')
                .then(r => r.json())
                .then(data => {
                    if(data.active) {
                        showSOSPopup(data.sos);
                    }
                }).catch(e => console.error("SOS Status Error", e));
        }

        function activateSOS() {
            // Instantly show modal to acknowledge activation
            sosModal.show();
            document.getElementById('sosLocationTxt').innerText = 'Requesting location...';
            document.getElementById('sosTimeTxt').innerText = new Date().toLocaleString();
            
            // Try to get location
            if ("geolocation" in navigator) {
                navigator.geolocation.getCurrentPosition(
                    pos => {
                        sendSOSRequest(pos.coords.latitude, pos.coords.longitude, `Lat: ${pos.coords.latitude.toFixed(4)}, Lng: ${pos.coords.longitude.toFixed(4)}`);
                    },
                    err => {
                        sendSOSRequest(null, null, "Location unavailable (Permission denied or failed)");
                    },
                    { enableHighAccuracy: true, timeout: 5000, maximumAge: 0 }
                );
            } else {
                sendSOSRequest(null, null, "Location not supported by browser");
            }
        }

        function sendSOSRequest(lat, lng, desc) {
            document.getElementById('sosLocationTxt').innerText = desc;
            
            fetch('/api/sos/activate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ Latitude: lat, Longitude: lng, LocationDescription: desc })
            })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    showSOSPopup(data.sos);
                }
            })
            .catch(e => {
                alert("We couldn't create the emergency request. Please try again or call security immediately.");
            });
        }

        function showSOSPopup(sos) {
            currentSosRequestId = sos.requestId;
            document.getElementById('sosRequestIdTxt').innerText = sos.requestId;
            document.getElementById('sosStatusTxt').innerText = sos.status === 'Created' ? 'Emergency Request Created' : sos.status;
            document.getElementById('sosLocationTxt').innerText = sos.locationDescription || 'Location unavailable';
            document.getElementById('sosTimeTxt').innerText = new Date(sos.createdAt).toLocaleString();
            sosModal.show();
        }

        function cancelSOS() {
            sosModal.hide();
            cancelSosModal.show();
        }

        function keepSosActive() {
            cancelSosModal.hide();
            sosModal.show();
        }

        function confirmCancelSOS() {
            if(!currentSosRequestId) return;
            
            fetch(`/api/sos/cancel/${currentSosRequestId}`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if(data.success) {
                    cancelSosModal.hide();
                    currentSosRequestId = null;
                    alert("SOS request cancelled.\nStatus: Cancelled");
                    // Refresh student dashboard so active SOS banner updates
                    window.location.reload();
                }
            });
        }
    </script>
    <style>
        .active-press {
            background-color: #991b1b !important;
            color: white !important;
            transform: scale(0.95);
            transition: all 3s linear;
        }
    </style>
    <partial name="_QuickHelpModal" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
