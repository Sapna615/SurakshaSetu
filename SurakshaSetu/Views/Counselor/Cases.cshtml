@model SurakshaSetu.ViewModels.SecurityIncidentQueueViewModel
@{
    ViewData["Title"] = "Sensitive Cases";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">Sensitive Cases</h2>
        <p class="text-muted">Manage harassment, bullying, and sensitive safety reports.</p>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="border-0">Report ID</th>
                        <th class="border-0">Category</th>
                        <th class="border-0">Location</th>
                        <th class="border-0">Created At</th>
                        <th class="border-0">Status</th>
                        <th class="border-0">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Incidents != null && Model.Incidents.Any())
                    {
                        foreach (var incident in Model.Incidents)
                        {
                            <tr>
                                <td class="fw-bold">@incident.ReportId</td>
                                <td><span class="badge bg-secondary">@incident.IncidentCategory</span></td>
                                <td>@incident.IncidentLocation</td>
                                <td>@incident.CreatedAt.ToString("HH:mm:ss") <small class="text-muted">(@incident.CreatedAt.ToString("dd MMM"))</small></td>
                                <td>
                                    @if(incident.Status == "Pending" || incident.Status == "Submitted") { <span class="badge bg-danger">@incident.Status</span> }
                                    else if(incident.Status == "In Progress") { <span class="badge bg-warning text-dark">@incident.Status</span> }
                                    else if(incident.Status == "Resolved") { <span class="badge bg-success">@incident.Status</span> }
                                    else { <span class="badge bg-info">@incident.Status</span> }
                                </td>
                                <td>
                                    <a href="/Security/IncidentDetails/@incident.SafetyReportId" class="btn btn-sm btn-primary">Review</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <div><span style="font-size: 2rem;">📋</span></div>
                                <div>No sensitive cases found.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
