@model SurakshaSetu.ViewModels.SuperAdminDashboardViewModel
@{
    ViewData["Title"] = "System Administration";
    Layout = "_SuperAdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">SurakshaSetu System Administration</h2>
        <p class="text-muted">Welcome, @Model.SuperAdminName</p>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
            <div class="card-body p-4 text-center">
                <div class="text-uppercase fw-bold mb-2 text-white-50" style="font-size: 0.8rem; letter-spacing: 1px;">TOTAL STUDENTS</div>
                <div class="fw-bold" style="font-size: 2.5rem;">@Model.TotalStudents</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
            <div class="card-body p-4 text-center">
                <div class="text-uppercase fw-bold mb-2 text-white-50" style="font-size: 0.8rem; letter-spacing: 1px;">SECURITY STAFF</div>
                <div class="fw-bold" style="font-size: 2.5rem;">@Model.TotalSecurityOfficers</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
            <div class="card-body p-4 text-center">
                <div class="text-uppercase fw-bold mb-2 text-white-50" style="font-size: 0.8rem; letter-spacing: 1px;">ADMINS</div>
                <div class="fw-bold" style="font-size: 2.5rem;">@Model.TotalAdmins</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-dark text-white">
            <div class="card-body p-4 text-center">
                <div class="text-uppercase fw-bold mb-2 text-white-50" style="font-size: 0.8rem; letter-spacing: 1px;">SUPER ADMINS</div>
                <div class="fw-bold" style="font-size: 2.5rem;">@Model.TotalSuperAdmins</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold">System Status</h4>
            </div>
            <div class="card-body p-4">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span class="fw-bold text-muted">Database Connection</span>
                        <span class="badge bg-success rounded-pill px-3 py-2">Healthy</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span class="fw-bold text-muted">Web Application</span>
                        <span class="badge bg-success rounded-pill px-3 py-2">Running</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center border-0 px-0">
                        <span class="fw-bold text-muted">Identity Service</span>
                        <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold">Recent Audit Logs</h4>
            </div>
            <div class="card-body p-4">
                <ul class="list-unstyled">
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <li class="mb-3 pb-2 border-bottom text-muted" style="font-size: 0.9rem;">
                            <span class="text-primary me-2">▶</span> @log
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
