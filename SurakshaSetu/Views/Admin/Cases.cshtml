@model SurakshaSetu.ViewModels.AdminCasesPageViewModel
@{
    ViewData["Title"] = "Case Management";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Case Management</h2>
            <p class="text-muted mb-0">Monitor and oversee all campus safety reports</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form method="get" action="/Admin/Cases" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Search Reports</label>
                <input type="text" name="searchQuery" class="form-control bg-light" placeholder="Report ID, Location, Description..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Category</label>
                <select name="categoryFilter" class="form-select bg-light">
                    <option value="">All Categories</option>
                    @foreach(var cat in Model.AvailableCategories)
                    {
                        if (Model.CategoryFilter == cat.Value)
                        {
                            <option value="@cat.Value" selected>@cat.Text</option>
                        }
                        else
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Severity</label>
                <select name="severityFilter" class="form-select bg-light">
                    <option value="">All Severities</option>
                    <!option value="Low" @(Model.SeverityFilter == "Low" ? "selected" : "")>Low</!option>
                    <!option value="Medium" @(Model.SeverityFilter == "Medium" ? "selected" : "")>Medium</!option>
                    <!option value="High" @(Model.SeverityFilter == "High" ? "selected" : "")>High</!option>
                    <!option value="Critical" @(Model.SeverityFilter == "Critical" ? "selected" : "")>Critical</!option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Status</label>
                <select name="statusFilter" class="form-select bg-light">
                    <option value="">All Statuses</option>
                    @foreach(var stat in Model.AvailableStatuses)
                    {
                        if (Model.StatusFilter == stat.Value)
                        {
                            <option value="@stat.Value" selected>@stat.Text</option>
                        }
                        else
                        {
                            <option value="@stat.Value">@stat.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Assigned To</label>
                <input type="text" name="assignedFilter" class="form-control bg-light" placeholder="Name or 'Unassigned'" value="@Model.AssignedFilter">
            </div>
            
            <div class="col-md-5">
                <label class="form-label fw-bold text-muted small">Date Range (Optional)</label>
                <div class="input-group">
                    <input type="date" name="startDate" class="form-control bg-light" value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                    <span class="input-group-text">to</span>
                    <input type="date" name="endDate" class="form-control bg-light" value="@Model.EndDate?.ToString("yyyy-MM-dd")">
                </div>
            </div>
            
            <div class="col-md-7 d-flex align-items-end justify-content-end">
                <a href="/Admin/Cases" class="btn btn-light fw-bold me-2">Clear</a>
                <button type="submit" class="btn btn-dark fw-bold px-4">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Report ID</th>
                        <th>Date & Time</th>
                        <th>Details</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Assignee</th>
                        <th class="pe-4 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Cases.Any())
                    {
                        foreach (var report in Model.Cases)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold @(report.ImmediateDanger ? "text-danger" : "text-dark")">@report.ReportId</div>
                                    @if(report.ImmediateDanger)
                                    {
                                        <span class="badge bg-danger mt-1">SOS</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@report.IncidentDate.ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@report.IncidentTime</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@report.IncidentCategory</div>
                                    <div>
                                        @if(report.Severity == "Critical") { <span class="badge bg-danger">Critical</span> }
                                        else if(report.Severity == "High") { <span class="badge bg-warning text-dark">High</span> }
                                        else if(report.Severity == "Medium") { <span class="badge bg-primary">Medium</span> }
                                        else { <span class="badge bg-info text-dark">Low</span> }
                                    </div>
                                </td>
                                <td class="text-truncate" style="max-width: 200px;">
                                    @report.IncidentLocation
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@report.Status</span>
                                </td>
                                <td>
                                    @if(string.IsNullOrEmpty(report.AssignedTo))
                                    {
                                        <span class="text-muted small fst-italic">Unassigned</span>
                                    }
                                    else
                                    {
                                        <div class="fw-bold small text-primary">@report.AssignedTo</div>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="/Admin/ViewCase/@report.SafetyReportId" class="btn btn-sm btn-outline-primary fw-bold">View</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div><span class="fs-1">🔍</span></div>
                                <div class="mt-2 fw-bold">No cases found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
