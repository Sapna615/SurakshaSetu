@model SurakshaSetu.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Campus Safety Administration";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold">Campus Safety Administration</h2>
        <p class="text-muted">Manage and monitor the SurakshaSetu campus safety system. Welcome, @Model.AdminName.</p>
    </div>
</div>

<!-- A. System Overview -->
<h4 class="fw-bold mb-3">System Overview</h4>
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <div class="text-muted fw-bold small text-uppercase mb-1">Total Students</div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalStudents</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <div class="text-muted fw-bold small text-uppercase mb-1">Total Counselors</div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalCounselors</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white">
            <div class="card-body p-3">
                <div class="text-muted fw-bold small text-uppercase mb-1">Security Staff</div>
                <div class="fs-3 fw-bold text-dark">@Model.TotalSecurityStaff</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-white border-start border-4 border-primary">
            <div class="card-body p-3">
                <div class="text-primary fw-bold small text-uppercase mb-1">Total Active Users</div>
                <div class="fs-3 fw-bold text-primary">@Model.TotalActiveUsers</div>
            </div>
        </div>
    </div>
</div>

<!-- F. Case Status Overview -->
<h4 class="fw-bold mb-3">Case Status Overview</h4>
<div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body p-3 text-center">
                <div class="text-muted fw-bold small mb-1">Total Reports</div>
                <div class="fs-4 fw-bold">@Model.TotalReports</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
            <div class="card-body p-3 text-center">
                <div class="text-muted fw-bold small mb-1">Open Cases</div>
                <div class="fs-4 fw-bold text-warning">@Model.OpenCases</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm rounded-4 h-100 bg-light">
            <div class="card-body p-3 text-center">
                <div class="text-muted fw-bold small mb-1">Resolved</div>
                <div class="fs-4 fw-bold text-success">@Model.ResolvedCases</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 h-100" style="background-color: #fef2f2; border: 1px solid #fee2e2 !important;">
            <div class="card-body p-3 text-center">
                <div class="text-danger fw-bold small mb-1">Active SOS</div>
                <div class="fs-4 fw-bold text-danger">@Model.ActiveSOS</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-12">
        <div class="card border-0 shadow-sm rounded-4 h-100" style="background-color: #fffbeb; border: 1px solid #fef3c7 !important;">
            <div class="card-body p-3 text-center">
                <div class="text-warning fw-bold small mb-1" style="color: #d97706 !important;">Active Safety Alerts</div>
                <div class="fs-4 fw-bold" style="color: #b45309;">@Model.ActiveSafetyAlerts</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    
    <div class="col-lg-8">
        <!-- B. Recent Incidents -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Incidents</h5>
                <a href="/Admin/Cases" class="btn btn-sm btn-light fw-bold">View All</a>
            </div>
            <div class="card-body p-4">
                @if (Model.RecentReports.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Date</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var report in Model.RecentReports)
                                {
                                    <tr>
                                        <td class="fw-bold small">@report.ReportId</td>
                                        <td class="small">@report.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td class="small">@report.IncidentCategory</td>
                                        <td><span class="badge bg-secondary">@report.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">No incident reports found.</div>
                }
            </div>
        </div>

        <!-- C. Recent SOS Requests -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent SOS Requests</h5>
                <a href="/Admin/Cases" class="btn btn-sm btn-light fw-bold">View All</a>
            </div>
            <div class="card-body p-4">
                @if (Model.RecentSOSRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>SOS ID</th>
                                    <th>Time</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sos in Model.RecentSOSRequests)
                                {
                                    <tr>
                                        <td class="fw-bold small text-danger">@sos.RequestId</td>
                                        <td class="small">@sos.CreatedAt.ToString("MMM dd HH:mm")</td>
                                        <td class="small">@sos.LocationDescription</td>
                                        <td><span class="badge @(sos.Status == "Active" ? "bg-danger" : "bg-secondary")">@sos.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">No active SOS requests found.</div>
                }
            </div>
        </div>
        
        <!-- D. Recent Safety Alerts -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Safety Alerts</h5>
                <a href="/Admin/SafetyAlerts" class="btn btn-sm btn-light fw-bold">View All</a>
            </div>
            <div class="card-body p-4">
                @if (Model.RecentSafetyAlerts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Published</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var alert in Model.RecentSafetyAlerts)
                                {
                                    <tr>
                                        <td class="fw-bold small">@alert.Title</td>
                                        <td class="small">@alert.Category</td>
                                        <td class="small">@alert.PublishedAt.ToString("MMM dd")</td>
                                        <td>
                                            @if (alert.IsActive && (alert.ExpiresAt == null || alert.ExpiresAt > DateTime.UtcNow))
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">No safety alerts found.</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        
        <!-- G. Quick Actions -->
        <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(145deg, #1e3a8a, #312e81);">
            <div class="card-body p-4 text-white">
                <h5 class="fw-bold mb-3"><i class="bi bi-lightning-charge-fill text-warning me-2"></i>Quick Actions</h5>
                
                <div class="d-grid gap-2">
                    <a href="/Admin/Users?action=add" class="btn btn-light fw-bold text-start"><span class="me-2">➕</span> Manage / Add User</a>
                    <a href="/Admin/Cases" class="btn btn-light fw-bold text-start"><span class="me-2">📋</span> Manage Cases</a>
                    <a href="/Admin/SafetyAlerts" class="btn btn-warning fw-bold text-start"><span class="me-2">⚠️</span> Create Safety Alert</a>
                    <a href="/Admin/EmergencyContacts" class="btn btn-light fw-bold text-start"><span class="me-2">📞</span> Emergency Contacts</a>
                    <a href="/Admin/Locations" class="btn btn-light fw-bold text-start"><span class="me-2">🏫</span> Campus Locations</a>
                    <a href="/Admin/Configuration" class="btn btn-light fw-bold text-start"><span class="me-2">⚙️</span> Manage Categories</a>
                    <a href="/Admin/Analytics" class="btn btn-light fw-bold text-start"><span class="me-2">📈</span> View Analytics</a>
                </div>
            </div>
        </div>

        <!-- E. Recent User Registrations -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">New Users</h5>
                <a href="/Admin/Users" class="btn btn-sm btn-light fw-bold">Manage</a>
            </div>
            <div class="card-body p-4">
                @if (Model.RecentUserRegistrations.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var u in Model.RecentUserRegistrations)
                        {
                            <div class="list-group-item px-0 border-0 mb-2">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-circle p-2 me-3 fs-5 text-secondary">👤</div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 0.9rem;">@u.FullName</div>
                                        <div class="text-muted small">@u.Email</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3">No recent users.</div>
                }
            </div>
        </div>

    </div>
</div>
