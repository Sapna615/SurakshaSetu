@model SurakshaSetu.ViewModels.AdminEmergencyContactFormViewModel
@{
    bool isCreate = Model.EmergencyContactId == 0;
    ViewData["Title"] = isCreate ? "Add Emergency Contact" : "Edit Emergency Contact";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center">
        <a href="/Admin/EmergencyContacts" class="btn btn-light rounded-circle shadow-sm me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <span>⬅️</span>
        </a>
        <div>
            <h2 class="fw-bold mb-1">@(isCreate ? "Add Emergency Contact" : "Edit Emergency Contact")</h2>
            <p class="text-muted mb-0">@(isCreate ? "Add a new entity to the campus emergency directory" : "Update an existing directory entry")</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 p-3 mb-4">
                        <div asp-validation-summary="All" class="text-danger fw-bold small mb-0"></div>
                    </div>
                }

                <form method="post" action="@(isCreate ? "/Admin/CreateEmergencyContact" : "/Admin/EditEmergencyContact")">
                    @Html.AntiForgeryToken()
                    @if (!isCreate)
                    {
                        <input type="hidden" asp-for="EmergencyContactId" />
                    }
                    
                    <div class="row g-5">
                        
                        <!-- Left Column: Primary Details -->
                        <div class="col-md-6 border-end">
                            <h5 class="fw-bold text-primary mb-4 pb-2">Primary Information</h5>
                            
                            <div class="mb-3">
                                <label asp-for="Name" class="form-label fw-bold text-muted small">Contact / Department Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control bg-light fw-bold" placeholder="e.g. Campus Security Main Office" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Department" class="form-label fw-bold text-muted small"></label>
                                    <input asp-for="Department" class="form-control bg-light" />
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Role" class="form-label fw-bold text-muted small"></label>
                                    <input asp-for="Role" class="form-control bg-light" placeholder="e.g. Chief Officer" />
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Category" class="form-label fw-bold text-muted small">Category <span class="text-danger">*</span></label>
                                <select asp-for="Category" asp-items="Model.AvailableCategories" class="form-select bg-light">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold text-muted small"></label>
                                <textarea asp-for="Description" class="form-control bg-light" rows="3" placeholder="Brief description visible to students..."></textarea>
                            </div>
                        </div>

                        <!-- Right Column: Contact & Configuration -->
                        <div class="col-md-6">
                            <h5 class="fw-bold text-primary mb-4 pb-2">Contact Details</h5>
                            
                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold text-muted small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">📞</span>
                                    <input asp-for="PhoneNumber" class="form-control bg-light border-start-0 ps-0" placeholder="+1 (555) 123-4567" />
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-bold text-muted small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">✉️</span>
                                    <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" type="email" placeholder="contact@campus.edu" />
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label asp-for="Location" class="form-label fw-bold text-muted small">Physical Location</label>
                                <input asp-for="Location" class="form-control bg-light" placeholder="e.g. Main Building, Room 101" />
                            </div>
                            
                            <div class="row g-3 mb-4">
                                <div class="col-md-8">
                                    <label asp-for="Availability" class="form-label fw-bold text-muted small">Operating Hours</label>
                                    <input asp-for="Availability" class="form-control bg-light" placeholder="e.g. Mon-Fri, 9AM-5PM" />
                                </div>
                                <div class="col-md-4 d-flex align-items-end pb-2">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" asp-for="Is24x7">
                                        <label class="form-check-label fw-bold small text-success" asp-for="Is24x7">
                                            24x7 Open
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <h5 class="fw-bold text-primary mb-4 border-bottom pb-2 mt-4">System Settings</h5>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" asp-for="IsEmergency">
                                <label class="form-check-label fw-bold mt-1" asp-for="IsEmergency">Primary Emergency</label>
                                <div class="text-muted small mt-1">Highlights this contact with red SOS styling.</div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 bg-light rounded-3 border">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" asp-for="ShowInQuickGuide">
                                <label class="form-check-label fw-bold mt-1" asp-for="ShowInQuickGuide">Quick Guide</label>
                                <div class="text-muted small mt-1">Show on the main "Who to Contact" student page.</div>
                            </div>
                        </div>
                        
                        <div class="col-md-4">
                            <div class="form-check form-switch p-3 rounded-3 border @(Model.IsActive ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-danger bg-opacity-10 border-danger border-opacity-25")">
                                <input class="form-check-input ms-0 me-3" type="checkbox" role="switch" asp-for="IsActive">
                                <label class="form-check-label fw-bold mt-1" asp-for="IsActive">Active & Visible</label>
                                <div class="text-muted small mt-1">If disabled, contact is hidden from everyone.</div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                        <div class="d-flex align-items-center w-25">
                            <label asp-for="DisplayOrder" class="form-label fw-bold text-muted small me-2 mb-0 text-nowrap">Sort Order</label>
                            <input asp-for="DisplayOrder" class="form-control form-control-sm bg-light w-50" type="number" />
                        </div>
                        
                        <div class="d-flex gap-2">
                            <a href="/Admin/EmergencyContacts" class="btn btn-light fw-bold px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary fw-bold px-5 shadow-sm">
                                @(isCreate ? "Add Contact" : "Save Changes")
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
