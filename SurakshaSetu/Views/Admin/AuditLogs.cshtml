@model SurakshaSetu.ViewModels.AdminAuditLogsPageViewModel
@{
    ViewData["Title"] = "System Audit Logs";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h2 class="fw-bold mb-1">System Audit Logs</h2>
        <p class="text-muted mb-0">Review comprehensive security and administrative activity logs</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form method="get" action="/Admin/AuditLogs" class="row g-3">
            <div class="col-md-5">
                <label class="form-label fw-bold text-muted small">Search Logs</label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchQuery" class="form-control bg-light border-start-0 ps-0" placeholder="Search action, user, details..." value="@Model.SearchQuery">
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">Start Date</label>
                <input type="date" name="startDate" class="form-control bg-light" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold text-muted small">End Date</label>
                <input type="date" name="endDate" class="form-control bg-light" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Timestamp</th>
                        <th>Action Type</th>
                        <th>User</th>
                        <th>Target Entity</th>
                        <th class="pe-4">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Logs.Any())
                    {
                        foreach (var log in Model.Logs)
                        {
                            <tr>
                                <td class="ps-4 py-3 text-nowrap">
                                    <div class="fw-bold text-dark">@log.Timestamp.ToLocalTime().ToString("MMM dd, yyyy")</div>
                                    <div class="text-muted small">@log.Timestamp.ToLocalTime().ToString("hh:mm:ss tt")</div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@log.Action</span>
                                </td>
                                <td>
                                    @if (log.User != null)
                                    {
                                        <div class="fw-bold text-dark">@log.User.FullName</div>
                                        <div class="text-muted small">@log.User.Email</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">System / Unknown User</span>
                                    }
                                </td>
                                <td>
                                    <div class="font-monospace text-muted small">@(string.IsNullOrEmpty(log.EntityId) ? "-" : log.EntityId)</div>
                                </td>
                                <td class="pe-4">
                                    <div class="text-dark" style="max-width: 400px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="@log.Details">
                                        @(string.IsNullOrEmpty(log.Details) ? "-" : log.Details)
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div><span class="fs-1">🔍</span></div>
                                <div class="mt-2 fw-bold">No audit logs found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.Logs.Count == 500)
    {
        <div class="card-footer bg-light border-0 text-center text-muted small py-3">
            <i class="bi bi-info-circle me-1"></i> Displaying the latest 500 records. Use filters to narrow down results.
        </div>
    }
</div>
