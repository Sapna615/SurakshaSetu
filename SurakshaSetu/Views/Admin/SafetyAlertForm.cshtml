@model SurakshaSetu.ViewModels.AdminSafetyAlertFormViewModel
@{
    bool isCreate = Model.SafetyAlertId == 0;
    ViewData["Title"] = isCreate ? "Create Safety Alert" : "Edit Safety Alert";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12 d-flex align-items-center">
        <a href="/Admin/SafetyAlerts" class="btn btn-light rounded-circle shadow-sm me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <span>⬅️</span>
        </a>
        <div>
            <h2 class="fw-bold mb-1">@(isCreate ? "Create Safety Alert" : "Edit Safety Alert")</h2>
            <p class="text-muted mb-0">@(isCreate ? "Broadcast a new safety notification to all campus users" : "Update an existing safety notification")</p>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white">
            <div class="card-body p-4 p-md-5">
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 p-3 mb-4">
                        <div asp-validation-summary="All" class="text-danger fw-bold small mb-0"></div>
                    </div>
                }

                <form method="post" action="@(isCreate ? "/Admin/CreateSafetyAlert" : "/Admin/EditSafetyAlert")">
                    @Html.AntiForgeryToken()
                    @if (!isCreate)
                    {
                        <input type="hidden" asp-for="SafetyAlertId" />
                    }
                    
                    <h5 class="fw-bold text-primary mb-4 border-bottom pb-2">Alert Details</h5>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label asp-for="Title" class="form-label fw-bold text-muted small">Alert Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control bg-light fs-5 fw-bold" placeholder="e.g. Severe Weather Warning" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-12">
                            <label asp-for="Message" class="form-label fw-bold text-muted small">Message / Details <span class="text-danger">*</span></label>
                            <textarea asp-for="Message" class="form-control bg-light" rows="4" placeholder="Detailed information about the alert..."></textarea>
                            <span asp-validation-for="Message" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-bold text-muted small">Category <span class="text-danger">*</span></label>
                            <select asp-for="Category" asp-items="Model.AvailableCategories" class="form-select bg-light">
                                <option value="">-- Select Category --</option>
                            </select>
                            <span asp-validation-for="Category" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-bold text-muted small">Priority Level <span class="text-danger">*</span></label>
                            <select asp-for="Priority" asp-items="Model.AvailablePriorities" class="form-select bg-light"></select>
                            <span asp-validation-for="Priority" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-12">
                            <label asp-for="Location" class="form-label fw-bold text-muted small">Affected Location (Optional)</label>
                            <input asp-for="Location" class="form-control bg-light" placeholder="e.g. North Campus, Main Library, All Campuses" />
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-12">
                            <label asp-for="RecommendedAction" class="form-label fw-bold text-muted small">Recommended Action (Optional)</label>
                            <textarea asp-for="RecommendedAction" class="form-control bg-light" rows="2" placeholder="e.g. Shelter in place, avoid the area..."></textarea>
                            <span asp-validation-for="RecommendedAction" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <h5 class="fw-bold text-primary mb-4 border-bottom pb-2 mt-5">Publishing Options</h5>
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="ExpiresAt" class="form-label fw-bold text-muted small"></label>
                            <input asp-for="ExpiresAt" class="form-control bg-light" type="datetime-local" />
                            <div class="form-text small">Leave blank if the alert does not expire automatically.</div>
                            <span asp-validation-for="ExpiresAt" class="text-danger small"></span>
                        </div>
                        
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check form-switch p-3 rounded-3 border w-100 @(Model.IsActive ? "bg-success bg-opacity-10 border-success border-opacity-25" : "bg-light")">
                                <input class="form-check-input ms-0 me-3 mt-2" type="checkbox" role="switch" asp-for="IsActive" style="transform: scale(1.3);">
                                <label class="form-check-label ms-1" asp-for="IsActive">
                                    <div class="fw-bold text-dark">Publish Alert Immediately</div>
                                    <div class="text-muted small" style="margin-top: -2px;">If unchecked, alert is saved as a draft.</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-4 border-top">
                        <a href="/Admin/SafetyAlerts" class="btn btn-light fw-bold px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary fw-bold px-5 shadow-sm">
                            <i class="bi bi-send-fill me-2"></i> @(isCreate ? "Publish Alert" : "Save Changes")
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
