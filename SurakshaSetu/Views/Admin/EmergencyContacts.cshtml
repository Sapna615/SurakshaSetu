@model SurakshaSetu.ViewModels.AdminEmergencyContactsPageViewModel
@{
    ViewData["Title"] = "Emergency Contacts";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">Emergency Contacts</h2>
            <p class="text-muted mb-0">Manage the campus emergency directory and hotlines</p>
        </div>
        <a href="/Admin/CreateEmergencyContact" class="btn btn-danger fw-bold px-4 rounded-3 shadow-sm">
            <span class="me-2">📞</span> Add Contact
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form method="get" action="/Admin/EmergencyContacts" class="row g-3">
            <div class="col-md-6">
                <label class="form-label fw-bold text-muted small">Search Contacts</label>
                <input type="text" name="searchQuery" class="form-control bg-light" placeholder="Search by name, dept, role, phone, email..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-muted small">Category</label>
                <select name="categoryFilter" class="form-select bg-light">
                    <option value="">All Categories</option>
                    @foreach(var cat in Model.AvailableCategories)
                    {
                        if (Model.CategoryFilter == cat.Value)
                        {
                            <option value="@cat.Value" selected>@cat.Text</option>
                        }
                        else
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Contact Info</th>
                        <th>Category</th>
                        <th>Phone / Email</th>
                        <th>Availability</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Contacts.Any())
                    {
                        foreach (var contact in Model.Contacts)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        @if(contact.IsEmergency)
                                        {
                                            <div class="me-3 fs-3 text-danger" title="Primary Emergency Contact">🚨</div>
                                        }
                                        else
                                        {
                                            <div class="me-3 fs-3 text-primary" title="Support Contact">ℹ️</div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark">@contact.Name</div>
                                            <div class="text-muted small">@contact.Department @(!string.IsNullOrEmpty(contact.Role) ? $"- {contact.Role}" : "")</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@contact.Category</span>
                                    @if(contact.ShowInQuickGuide)
                                    {
                                        <div class="small text-primary mt-1"><i class="bi bi-star-fill"></i> Quick Guide</div>
                                    }
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(contact.PhoneNumber))
                                    {
                                        <div class="fw-bold @(contact.CanCall ? "text-primary" : "text-dark")">
                                            @if(contact.CanCall) { <i class="bi bi-telephone-fill me-1"></i> }
                                            @contact.PhoneNumber
                                        </div>
                                    }
                                    @if(!string.IsNullOrEmpty(contact.Email))
                                    {
                                        <div class="text-muted small"><i class="bi bi-envelope-fill me-1"></i> @contact.Email</div>
                                    }
                                </td>
                                <td>
                                    @if(contact.Is24x7)
                                    {
                                        <span class="badge bg-success">24x7 Available</span>
                                    }
                                    else if(!string.IsNullOrEmpty(contact.Availability))
                                    {
                                        <span class="text-dark small fw-bold">@contact.Availability</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Not specified</span>
                                    }
                                </td>
                                <td>
                                    @if(contact.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="/Admin/EditEmergencyContact/@contact.EmergencyContactId" class="btn btn-sm btn-outline-primary fw-bold me-2">Edit</a>
                                    
                                    <form method="post" action="/Admin/ToggleEmergencyContact/@contact.EmergencyContactId" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if(contact.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold">Hide</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold">Show</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <div><span class="fs-1">📞</span></div>
                                <div class="mt-2 fw-bold">No emergency contacts found.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
