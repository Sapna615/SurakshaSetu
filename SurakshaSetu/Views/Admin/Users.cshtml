@model SurakshaSetu.ViewModels.AdminUsersPageViewModel
@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1">User Management</h2>
            <p class="text-muted mb-0">View, filter, and manage system accounts</p>
        </div>
        <a href="/Identity/Account/Register" class="btn btn-primary fw-bold px-4 rounded-3 shadow-sm">
            <span class="me-2">➕</span> Add New User
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-4">
        <form method="get" action="/Admin/Users" class="row g-3">
            <div class="col-md-4">
                <label class="form-label fw-bold text-muted small">Search Users</label>
                <input type="text" name="searchQuery" class="form-control bg-light" placeholder="Name, Email, or ID..." value="@Model.SearchQuery">
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Role</label>
                <select name="roleFilter" class="form-select bg-light">
                    <option value="">All Roles</option>
                    @foreach(var role in Model.AvailableRoles)
                    {
                        if (Model.RoleFilter == role.Value)
                        {
                            <option value="@role.Value" selected>@role.Text</option>
                        }
                        else
                        {
                            <option value="@role.Value">@role.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Department</label>
                <select name="departmentFilter" class="form-select bg-light">
                    <option value="">All Departments</option>
                    @foreach(var dept in Model.AvailableDepartments)
                    {
                        if (Model.DepartmentFilter == dept.Value)
                        {
                            <option value="@dept.Value" selected>@dept.Text</option>
                        }
                        else
                        {
                            <option value="@dept.Value">@dept.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold text-muted small">Status</label>
                <select name="statusFilter" class="form-select bg-light">
                    <option value="">All Statuses</option>
                    <!option value="Active" @(Model.StatusFilter == "Active" ? "selected" : "")>Active</!option>
                    <!option value="Inactive" @(Model.StatusFilter == "Inactive" ? "selected" : "")>Inactive</!option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-dark w-100 fw-bold">Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">User</th>
                        <th>ID / Department</th>
                        <th>Roles</th>
                        <th>Status</th>
                        <th class="pe-4 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark">@user.FullName</div>
                                    <div class="text-muted small">@user.Email</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-secondary">@(user.StudentId ?? "-")</div>
                                    <div class="text-muted small">@(user.Department ?? "N/A")</div>
                                </td>
                                <td>
                                    @if(user.Roles.Any())
                                    {
                                        foreach(var role in user.Roles)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 me-1 mb-1">@role</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No Roles</span>
                                    }
                                </td>
                                <td>
                                    @if(user.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a href="/Admin/EditUser/@user.Id" class="btn btn-sm btn-outline-primary fw-bold me-2">Edit</a>
                                    
                                    <form method="post" action="/Admin/ToggleUserStatus/@user.Id" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if(user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger fw-bold" onclick="return confirm('Are you sure you want to deactivate @user.FullName?');">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-bold" onclick="return confirm('Are you sure you want to activate @user.FullName?');">Activate</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <div><span class="fs-1">🔍</span></div>
                                <div class="mt-2 fw-bold">No users found matching your criteria.</div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
