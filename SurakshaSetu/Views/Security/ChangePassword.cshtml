@model SurakshaSetu.ViewModels.ChangePasswordViewModel
@{
    Layout = User.IsInRole("SuperAdmin") ? "_SuperAdminLayout" : 
             User.IsInRole("Admin") ? "_AdminLayout" : 
             User.IsInRole("Student") ? "_DashboardLayout" : "_SecurityLayout";
    ViewData["Title"] = "Change Password";
}

<style>
    .cp-wrapper {
        min-height: calc(100vh - 100px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
        cursor: url('data:image/svg+xml;utf8,<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10" stroke="%233b82f6" stroke-width="2"/><circle cx="12" cy="12" r="3" fill="%233b82f6"/></svg>') 12 12, auto;
    }

    #cp-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
    }

    .cp-wrapper::before {
        content: '';
        position: absolute;
        top: -20%;
        left: -10%;
        width: 500px;
        height: 500px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(37,99,235,0.15) 0%, rgba(37,99,235,0) 70%);
        z-index: 0;
    }

    .cp-wrapper::after {
        content: '';
        position: absolute;
        bottom: -20%;
        right: -10%;
        width: 400px;
        height: 400px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(139,92,246,0.15) 0%, rgba(139,92,246,0) 70%);
        z-index: 0;
    }

    .cp-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: 24px;
        padding: 40px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 1;
        width: 100%;
        max-width: 500px;
    }

    .cp-title {
        font-weight: 800;
        color: #0f172a;
        margin-bottom: 8px;
        text-align: center;
        font-size: 1.8rem;
        letter-spacing: -0.5px;
    }

    .cp-subtitle {
        color: #64748b;
        text-align: center;
        margin-bottom: 30px;
        font-size: 0.95rem;
    }

    .form-control-cp {
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid #e2e8f0;
        background-color: rgba(255, 255, 255, 0.8);
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control-cp:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.1);
        background-color: #fff;
    }

    .btn-cp {
        background-color: #2563eb;
        border: none;
        border-radius: 12px;
        padding: 14px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
        color: white;
    }

    .btn-cp:hover {
        background-color: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 15px 25px -5px rgba(37, 99, 235, 0.4);
        color: white;
    }

</style>

<div class="cp-wrapper" id="cp-wrapper">
    <canvas id="cp-canvas"></canvas>
    <div class="cp-card">
        
        @if (TempData["StatusMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 border-0" role="alert" style="font-size: 0.9rem;">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["StatusMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div style="text-align: center; font-size: 2.5rem; margin-bottom: 10px;">🔐</div>
        <h4 class="cp-title">Change Password</h4>
        <p class="cp-subtitle">Keep your account secure by using a strong password.</p>
        
        <form method="post" action="/@(ViewContext.RouteData.Values["Controller"]?.ToString())/ChangePassword">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger mb-4 fw-bold small"></div>

            <div class="form-floating mb-4">
                <input asp-for="OldPassword" type="password" class="form-control form-control-cp" autocomplete="current-password" aria-required="true" placeholder="Old Password" />
                <label asp-for="OldPassword" style="color: #64748b; padding-left: 16px;">Current Password</label>
                <span asp-validation-for="OldPassword" class="text-danger small fw-bold mt-1 d-block"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="NewPassword" type="password" class="form-control form-control-cp" autocomplete="new-password" aria-required="true" placeholder="New Password" />
                <label asp-for="NewPassword" style="color: #64748b; padding-left: 16px;">New Password</label>
                <span asp-validation-for="NewPassword" class="text-danger small fw-bold mt-1 d-block"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="ConfirmPassword" type="password" class="form-control form-control-cp" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                <label asp-for="ConfirmPassword" style="color: #64748b; padding-left: 16px;">Confirm New Password</label>
                <span asp-validation-for="ConfirmPassword" class="text-danger small fw-bold mt-1 d-block"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit" class="btn btn-cp w-100">
                    Update Securely
                </button>
            </div>
        </form>
        
        <div class="text-center mt-4">
            <a href="/@(ViewContext.RouteData.Values["Controller"]?.ToString())/Profile" style="color: #64748b; text-decoration: none; font-weight: 600; font-size: 0.9rem;">
                ← Back to Profile
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const cpCanvas = document.getElementById('cp-canvas');
        const cpCtx = cpCanvas.getContext('2d');
        const wrapper = document.getElementById('cp-wrapper');
        
        let cpWidth, cpHeight;
        let cpParticles = [];
        let cpMouse = { x: -1000, y: -1000 };
        
        function cpResize() {
            cpWidth = cpCanvas.width = wrapper.clientWidth;
            cpHeight = cpCanvas.height = wrapper.clientHeight;
        }
        window.addEventListener('resize', cpResize);
        cpResize();

        wrapper.addEventListener('mousemove', (e) => {
            const rect = wrapper.getBoundingClientRect();
            cpMouse.x = e.clientX - rect.left;
            cpMouse.y = e.clientY - rect.top;
            
            for (let i = 0; i < 3; i++) {
                cpParticles.push(new CpSparkle(cpMouse.x, cpMouse.y));
            }
        });

        class CpParticle {
            constructor() {
                this.x = Math.random() * cpWidth;
                this.y = Math.random() * cpHeight;
                this.z = Math.random() * 2 + 0.1;
                this.vx = (Math.random() - 0.5) * 0.5;
                this.vy = (Math.random() - 0.5) * 0.5;
                this.radius = Math.random() * 2 + 1;
                this.color = `rgba(${Math.floor(Math.random()*100 + 100)}, ${Math.floor(Math.random()*150 + 100)}, 255, ${Math.random() * 0.5 + 0.2})`;
            }
            update() {
                this.x += this.vx / this.z;
                this.y += this.vy / this.z;
                if (this.x < 0 || this.x > cpWidth) this.vx *= -1;
                if (this.y < 0 || this.y > cpHeight) this.vy *= -1;
            }
            draw() {
                cpCtx.beginPath();
                cpCtx.arc(this.x, this.y, this.radius / this.z, 0, Math.PI * 2);
                cpCtx.fillStyle = this.color;
                cpCtx.fill();
            }
        }

        class CpSparkle {
            constructor(x, y) {
                this.x = x + (Math.random() - 0.5) * 20;
                this.y = y + (Math.random() - 0.5) * 20;
                this.vx = (Math.random() - 0.5) * 4;
                this.vy = (Math.random() - 0.5) * 4 - 2;
                this.life = 1.0;
                this.decay = Math.random() * 0.02 + 0.015;
                this.color = `hsl(${Math.random() * 60 + 200}, 100%, 70%)`;
                this.size = Math.random() * 3 + 1;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                this.life -= this.decay;
            }
            draw() {
                if (this.life <= 0) return;
                cpCtx.beginPath();
                cpCtx.arc(this.x, this.y, this.size * this.life, 0, Math.PI * 2);
                cpCtx.fillStyle = this.color;
                cpCtx.globalAlpha = this.life;
                cpCtx.fill();
                cpCtx.globalAlpha = 1.0;
            }
        }

        for (let i = 0; i < 40; i++) {
            cpParticles.push(new CpParticle());
        }

        function cpAnimate() {
            cpCtx.fillStyle = 'rgba(15, 23, 42, 0.2)';
            cpCtx.fillRect(0, 0, cpWidth, cpHeight);
            
            const bgs = cpParticles.filter(p => p instanceof CpParticle);
            for (let i = 0; i < bgs.length; i++) {
                for (let j = i + 1; j < bgs.length; j++) {
                    const dx = bgs[i].x - bgs[j].x;
                    const dy = bgs[i].y - bgs[j].y;
                    const dist = Math.sqrt(dx*dx + dy*dy);
                    if (dist < 150) {
                        cpCtx.beginPath();
                        cpCtx.moveTo(bgs[i].x, bgs[i].y);
                        cpCtx.lineTo(bgs[j].x, bgs[j].y);
                        cpCtx.strokeStyle = `rgba(100, 150, 255, ${0.15 * (1 - dist/150)})`;
                        cpCtx.lineWidth = 1;
                        cpCtx.stroke();
                    }
                }
            }

            for (let i = cpParticles.length - 1; i >= 0; i--) {
                const p = cpParticles[i];
                p.update();
                p.draw();
                if (p instanceof CpSparkle && p.life <= 0) {
                    cpParticles.splice(i, 1);
                }
            }
            
            bgs.forEach(p => {
                const dx = cpMouse.x - p.x;
                const dy = cpMouse.y - p.y;
                if (Math.sqrt(dx*dx + dy*dy) < 100) {
                    p.x -= dx * 0.02;
                    p.y -= dy * 0.02;
                }
            });

            requestAnimationFrame(cpAnimate);
        }
        
        cpAnimate();
    </script>
}
