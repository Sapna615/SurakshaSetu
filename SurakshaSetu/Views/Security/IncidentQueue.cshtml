@model SurakshaSetu.ViewModels.SecurityIncidentQueueViewModel
@{
    Layout = "_SecurityLayout";
    var pageTitle = ViewData["Title"] as string ?? "Incident Queue";
    ViewData["Title"] = pageTitle;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-1 text-gray-800">@pageTitle</h2>
        <p class="text-muted">Review, prioritize and respond to @pageTitle.ToLower().</p>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between bg-dark-subtle">
        <h6 class="m-0 font-weight-bold text-primary">Filters</h6>
    </div>
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-3">
                <label class="form-label text-sm text-muted">Search</label>
                <input type="text" name="search" class="form-control" value="@Model.SearchQuery" placeholder="Report ID, Location, etc.">
            </div>
            <div class="col-md-2">
                <label class="form-label text-sm text-muted">Category</label>
                <select name="category" class="form-select">
                    <option>All Categories</option>
                    @foreach(var cat in Model.AvailableCategories)
                    {
                        if(Model.Category == cat) {
                            <option selected>@cat</option>
                        } else {
                            <option>@cat</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-sm text-muted">Severity</label>
                <select name="severity" class="form-select">
                    <option>All Severities</option>
                    <option selected="@(Model.Severity == "Low")">Low</option>
                    <option selected="@(Model.Severity == "Medium")">Medium</option>
                    <option selected="@(Model.Severity == "High")">High</option>
                    <option selected="@(Model.Severity == "Critical")">Critical</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-sm text-muted">Status</label>
                <select name="status" class="form-select">
                    <option>All Statuses</option>
                    <option selected="@(Model.Status == "Pending")">Pending</option>
                    <option selected="@(Model.Status == "Assigned")">Assigned</option>
                    <option selected="@(Model.Status == "In Progress")">In Progress</option>
                    <option selected="@(Model.Status == "Resolved")">Resolved</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Report ID</th>
                        <th>Category</th>
                        <th>Location</th>
                        <th>Severity</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Incidents)
                    {
                        <tr>
                            <td class="fw-bold">@item.ReportId</td>
                            <td>@item.IncidentCategory</td>
                            <td>@item.IncidentLocation</td>
                            <td>
                                @if(item.Severity == "Critical") {
                                    <span class="badge bg-danger">Critical</span>
                                } else if(item.Severity == "High") {
                                    <span class="badge bg-warning text-dark">High</span>
                                } else if(item.Severity == "Medium") {
                                    <span class="badge bg-info text-dark">Medium</span>
                                } else {
                                    <span class="badge bg-secondary">Low</span>
                                }
                            </td>
                            <td>
                                @if(item.Status == "Pending" || item.Status == "Submitted") {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                } else if(item.Status == "Resolved") {
                                    <span class="badge bg-success">Resolved</span>
                                } else {
                                    <span class="badge bg-primary">@item.Status</span>
                                }
                            </td>
                            <td><span title="@item.CreatedAt.ToLocalTime()">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span></td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-success me-1" data-bs-toggle="modal" data-bs-target="#queueStatusModal_@item.SafetyReportId">
                                    Update Status
                                </button>
                                <a asp-controller="Security" asp-action="IncidentDetails" asp-route-id="@item.SafetyReportId" class="btn btn-sm btn-outline-primary">View</a>

                                <!-- Quick Update Status Modal -->
                                <div class="modal fade" id="queueStatusModal_@item.SafetyReportId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content" style="background: #111a28; border: 1px solid #1e2d42; color: #ffffff;">
                                            <form asp-controller="Security" asp-action="UpdateIncidentStatus" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.SafetyReportId" />
                                                <input type="hidden" name="returnUrl" value="/Security/IncidentQueue" />
                                                <div class="modal-header" style="border-bottom: 1px solid #1e2d42;">
                                                    <h5 class="modal-title fw-bold">Update Status - @item.ReportId</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body text-start">
                                                    <div class="mb-3">
                                                        <label class="form-label small text-muted">Current Status</label>
                                                        <div><span class="badge bg-primary px-3 py-2">@item.Status</span></div>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small" style="color: #cbd5e1;">Select New Status</label>
                                                        <select name="newStatus" class="form-select" required style="background: #09101a; border-color: #1e2d42; color: #ffffff;">
                                                            <option value="Assigned" selected="@(item.Status == "Assigned")">Assigned</option>
                                                            <option value="Under Review" selected="@(item.Status == "Under Review")">Under Review</option>
                                                            <option value="In Progress" selected="@(item.Status == "In Progress")">In Progress (Active Response)</option>
                                                            <option value="Under Investigation" selected="@(item.Status == "Under Investigation")">Under Investigation</option>
                                                            <option value="Action Taken" selected="@(item.Status == "Action Taken")">Action Taken</option>
                                                            <option value="Resolved" selected="@(item.Status == "Resolved")">Resolved & Closed</option>
                                                        </select>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small" style="color: #cbd5e1;">Action Taken / Officer Note</label>
                                                        <textarea name="responseNote" class="form-control" rows="3" placeholder="Explain the current position / response taken (this is visible to the reporting student)..." style="background: #09101a; border-color: #1e2d42; color: #ffffff;"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer" style="border-top: 1px solid #1e2d42;">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary fw-bold">Save Status Update</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if(!Model.Incidents.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No incidents found matching your criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
