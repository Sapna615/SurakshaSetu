@model SurakshaSetu.ViewModels.SecurityIncidentDetailsViewModel
@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_SecurityLayout";
    ViewData["Title"] = "Incident Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-1 text-gray-800">Incident @Model.Incident.ReportId</h2>
        <a href="javascript:history.back()" class="text-decoration-none">&larr; Back to Queue</a>
    </div>
    @if(Model.Incident.Status != "Resolved" && Model.Incident.Status != "Cancelled")
    {
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#resolveModal">
            Resolve Incident
        </button>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-light">
                <h6 class="m-0 font-weight-bold text-primary">Incident Information</h6>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-sm-3 text-muted">Category</div>
                    <div class="col-sm-9 fw-bold">@Model.Incident.IncidentCategory</div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-3 text-muted">Severity</div>
                    <div class="col-sm-9">
                        @if(Model.Incident.Severity == "Critical") {
                            <span class="badge bg-danger">Critical</span>
                        } else if(Model.Incident.Severity == "High") {
                            <span class="badge bg-warning text-dark">High</span>
                        } else if(Model.Incident.Severity == "Medium") {
                            <span class="badge bg-info text-dark">Medium</span>
                        } else {
                            <span class="badge bg-secondary">Low</span>
                        }
                    </div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-3 text-muted">Location</div>
                    <div class="col-sm-9">@Model.LocationName</div>
                </div>
                <div class="row mb-4">
                    <div class="col-sm-3 text-muted">Time Reported</div>
                    <div class="col-sm-9">@Model.Incident.IncidentDate.ToShortDateString() at @Model.Incident.IncidentTime</div>
                </div>
                
                <hr>
                
                <h6 class="font-weight-bold mt-4 mb-3">Description</h6>
                <p class="text-dark bg-light p-3 rounded border">
                    @Model.Incident.Description
                </p>
                
                @if(Model.Incident.ImmediateDanger || Model.Incident.MedicalAssistanceRequired || Model.Incident.SecurityAssistanceRequired)
                {
                    <h6 class="font-weight-bold mt-4 mb-3 text-danger">Requested Assistance</h6>
                    <ul class="list-group mb-4">
                        @if(Model.Incident.ImmediateDanger) { <li class="list-group-item list-group-item-danger">Immediate Danger</li> }
                        @if(Model.Incident.MedicalAssistanceRequired) { <li class="list-group-item">Medical Assistance</li> }
                        @if(Model.Incident.SecurityAssistanceRequired) { <li class="list-group-item">Security Assistance</li> }
                    </ul>
                }
            </div>
        </div>
        
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-light">
                <h6 class="m-0 font-weight-bold text-primary">Resolution Notes</h6>
            </div>
            <div class="card-body">
                @if(string.IsNullOrEmpty(Model.Incident.ResolutionNotes))
                {
                    <p class="text-muted fst-italic">No resolution notes added yet.</p>
                }
                else
                {
                    <pre class="bg-light p-3 rounded border text-wrap" style="font-family: inherit;">@Model.Incident.ResolutionNotes</pre>
                }
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Status Panel -->
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-light">
                <h6 class="m-0 font-weight-bold text-primary">Workflow</h6>
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <div class="text-muted small mb-1">Current Status</div>
                    <div class="h5">
                        @if(Model.Incident.Status == "Pending" || Model.Incident.Status == "Submitted") {
                            <span class="badge bg-warning text-dark w-100 py-2">Pending</span>
                        } else if(Model.Incident.Status == "Resolved") {
                            <span class="badge bg-success w-100 py-2">Resolved</span>
                        } else {
                            <span class="badge bg-primary w-100 py-2">@Model.Incident.Status</span>
                        }
                    </div>
                </div>
                
                <div class="mb-4">
                    <div class="text-muted small mb-1">Assigned To</div>
                    <div class="fw-bold">
                        @if(Model.AssignedOfficer != null) {
                            @Model.AssignedOfficer.FullName
                        } else {
                            <span class="text-muted fst-italic">Unassigned</span>
                        }
                    </div>
                </div>
                
                @if(Model.Incident.Status != "Resolved" && Model.Incident.Status != "Cancelled")
                {
                    <hr>
                    <form asp-action="UpdateIncidentStatus" method="post">
                        <input type="hidden" name="id" value="@Model.Incident.SafetyReportId" />
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted">Update Status</label>
                            <select name="newStatus" class="form-select form-select-sm">
                                <option value="">(No change)</option>
                                <option value="Assigned">Assigned</option>
                                <option value="In Progress">In Progress</option>
                                <option value="Under Investigation">Under Investigation</option>
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted">Assign To</label>
                            <select name="assignToEmail" class="form-select form-select-sm">
                                <option value="">(No change)</option>
                                @foreach(var officer in Model.AvailableOfficers)
                                {
                                    <option value="@officer.Email">@officer.FullName</option>
                                }
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label small text-muted">Add Note</label>
                            <textarea name="responseNote" class="form-control form-control-sm" rows="3" placeholder="Type response note here..."></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary btn-sm w-100">Update Case</button>
                    </form>
                }
            </div>
        </div>
        
        <!-- Reporter Info Panel -->
        <div class="card shadow mb-4">
            <div class="card-header py-3 bg-light">
                <h6 class="m-0 font-weight-bold text-primary">Reporter Information</h6>
            </div>
            <div class="card-body">
                @if(Model.Incident.IsAnonymous)
                {
                    <div class="text-center py-3">
                        <div class="text-muted mb-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-incognito" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M4.736 1.968a.892.892 0 0 0-1.402-.115l-1.6 1.92a.9.9 0 0 0-.154.512V6a.5.5 0 0 0 .5.5h11.844a.5.5 0 0 0 .5-.5V4.285a.9.9 0 0 0-.154-.512l-1.6-1.92a.892.892 0 0 0-1.402.115l-1.56 2.34a.3.3 0 0 1-.498 0l-1.56-2.34a.892.892 0 0 0-1.402-.115l-1.56 2.34a.3.3 0 0 1-.498 0l-1.56-2.34ZM2 7a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2H2Zm1.5 5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3Zm9 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3ZM6.5 10a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5Z"/>
                            </svg>
                        </div>
                        <h6 class="fw-bold text-dark">Anonymous Reporter</h6>
                        <p class="small text-muted mb-0">Identity hidden per safety protocols.</p>
                    </div>
                }
                else if(Model.Reporter != null)
                {
                    <div class="mb-2">
                        <div class="text-muted small">Name</div>
                        <div class="fw-bold">@Model.Reporter.FullName</div>
                    </div>
                    <div class="mb-2">
                        <div class="text-muted small">Email</div>
                        <div><a href="mailto:@Model.Reporter.Email">@Model.Reporter.Email</a></div>
                    </div>
                    @if(!string.IsNullOrEmpty(Model.Reporter.PhoneNumber))
                    {
                        <div class="mb-2">
                            <div class="text-muted small">Phone</div>
                            <div><a href="tel:@Model.Reporter.PhoneNumber">@Model.Reporter.PhoneNumber</a></div>
                        </div>
                    }
                    @if(!string.IsNullOrEmpty(Model.Reporter.StudentId))
                    {
                        <div class="mb-2">
                            <div class="text-muted small">ID</div>
                            <div>@Model.Reporter.StudentId</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted fst-italic">Reporter information unavailable.</div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Resolve Modal -->
<div class="modal fade" id="resolveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateIncidentStatus" method="post">
                <input type="hidden" name="id" value="@Model.Incident.SafetyReportId" />
                <input type="hidden" name="newStatus" value="Resolved" />
                
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title">Resolve Incident</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to mark this incident as resolved?</p>
                    <div class="mb-3">
                        <label class="form-label">Resolution Note (Required)</label>
                        <textarea name="responseNote" class="form-control" rows="4" required placeholder="Describe how this case was resolved..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Mark as Resolved</button>
                </div>
            </form>
        </div>
    </div>
</div>
