@model SurakshaSetu.ViewModels.SecurityIncidentQueueViewModel
@{
    Layout = "_SecurityLayout";
    ViewData["Title"] = "Active SOS";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="h3 mb-1 text-danger font-weight-bold">🚨 Active Emergency SOS</h2>
        <p class="text-muted">High priority emergency requests requiring immediate response.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4 border-danger border-top border-4">
    <div class="card-body p-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>SOS ID</th>
                        <th>Emergency Type</th>
                        <th>Location</th>
                        <th>Created At</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Incidents)
                    {
                        <tr>
                            <td class="fw-bold">@item.ReportId</td>
                            <td><span class="badge bg-danger">Immediate Danger</span></td>
                            <td><span class="fw-bold">@item.IncidentLocation</span></td>
                            <td><span class="text-danger fw-bold">@item.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</span> (@item.CreatedAt.ToLocalTime().ToString("dd MMM"))</td>
                            <td>
                                <span class="badge bg-warning text-dark">@item.Status</span>
                            </td>
                            <td>
                                <a asp-controller="Security" asp-action="IncidentDetails" asp-route-id="@item.SafetyReportId" class="btn btn-sm btn-danger fw-bold">Respond Now</a>
                            </td>
                        </tr>
                    }
                    @if(!Model.Incidents.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-success font-weight-bold">
                                <div style="font-size: 2rem; margin-bottom: 10px;">✅</div>
                                There are currently no active emergency SOS requests.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
